// Universal differentiable Tensor operations (`tensor.ops`):
// - Default N-D NumPy-style broadcasting arithmetic (`+`, `-`, `*`, `/`) with automatic unbroadcasting
// - Elementwise math & activations (`exp`, `log`, `sqrt`, `rsqrt`, `abs`, `square`, `tanh`, `sigmoid`, `clamp`, `round`, `silu`, `gelu`, `relu`, `leakyRelu`, `softplus`)
// - Linear algebra (`matmul`, `matmulNT`, `bgemm`, `bgemmNT`)
// - Axis transforms (`reshape`, `squeeze`, `unsqueeze`, `transpose2d`, `transpose0213`, `sliceAxis`, `chunkAxis`, `catAxis`, `padAxis`)
// - Reductions (`sumAll`, `meanAll`, `sumAxis`, `meanAxis`, `maxAxis`, `logSumExpLast`, `sumSqFloat`, `l2NormFloat`)
// - Norms, Attention, Embedding & Losses (`rmsNorm`, `layerNorm`, `l2NormLast`, `softmax`, `logSoftmax`, `crossEntropy`, `crossEntropyIgnore`, `mseLoss`, `embedding`, `rope`, `causalMask`)

use std.option.{Option, Some, None}
use std.list.{listLen, listRev}
use tensor.backend.{
    Device, Cpu, devKind, devId,
    c_sgemm, c_bgemm, c_add, c_sub, c_mul, c_div_ew, c_scale, c_add_scalar,
    c_pow_scalar_fwd, c_pow_scalar_bwd, c_clamp_fwd, c_clamp_bwd,
    c_leaky_relu_fwd, c_leaky_relu_bwd, c_bcast_binop, c_bcast_reduce_sum,
    c_unary_fwd, c_unary_bwd, c_slice_axis_fwd, c_slice_axis_bwd,
    c_sum_axis, c_max_axis, c_sum_all, c_sum_sq,
    c_rms_norm_fwd, c_rms_norm_bwd, c_layer_norm_fwd, c_layer_norm_bwd,
    c_l2_norm_last_fwd, c_l2_norm_last_bwd,
    c_softmax_fwd, c_softmax_bwd, c_log_sum_exp_fwd, c_log_sum_exp_bwd,
    c_ce_fwd, c_ce_bwd, c_emb_fwd, c_emb_bwd, c_rope_fwd, c_rope_bwd,
    c_transpose_2d, c_transpose_0213, c_causal_mask_add
}
use tensor.tensor.{
    Tensor, IntTensor, allocTensorOn, fullOn, zerosOn, onesOn, cloneTensor, detach, item, axpyInPlace,
    shapeProd, shapeEq, dimAt, normalizeAxis, broadcastShape, broadcastStrides, packI32List,
    customVjp
}

// ============================================================================
// Internal Broadcasting & Reduction Helpers
// ============================================================================

def unbroadcastRaw(g: Tensor, targetShape: List Int): Tensor =
    if (shapeEq(g.shape, targetShape)) g
    else {
        let out = allocTensorOn(targetShape, g.device);
        let nd = listLen(g.shape);
        let shBuf = packI32List(g.shape);
        let stBuf = packI32List(broadcastStrides(targetShape, g.shape));
        c_bcast_reduce_sum(
            devKind(g.device), devId(g.device),
            nd, intToI64(g.numel), intToI64(out.numel),
            shBuf, stBuf, g.buf, out.buf
        );
        out
    }

def rawBinop(op: Int, a: Tensor, b: Tensor): Tensor = {
    let dk = devKind(a.device);
    let did = devId(a.device);
    if (shapeEq(a.shape, b.shape)) {
        let out = allocTensorOn(a.shape, a.device);
        let n = intToI64(a.numel);
        if (op == 0) c_add(dk, did, a.buf, b.buf, out.buf, n)
        else if (op == 1) c_sub(dk, did, a.buf, b.buf, out.buf, n)
        else if (op == 2) c_mul(dk, did, a.buf, b.buf, out.buf, n)
        else c_div_ew(dk, did, a.buf, b.buf, out.buf, n);
        out
    } else {
        let outSh = broadcastShape(a.shape, b.shape);
        let out = allocTensorOn(outSh, a.device);
        let shBuf = packI32List(outSh);
        let saBuf = packI32List(broadcastStrides(a.shape, outSh));
        let sbBuf = packI32List(broadcastStrides(b.shape, outSh));
        c_bcast_binop(dk, did, op, listLen(outSh), intToI64(out.numel), shBuf, saBuf, sbBuf, a.buf, b.buf, out.buf);
        out
    }
}

// ============================================================================
// Broadcasting Arithmetic (`+`, `-`, `*`, `/`, `-x`) & Scalar Ops
// ============================================================================

pub def add(a: Tensor, b: Tensor): Tensor = {
    let out = rawBinop(0, a, b);
    let aid = a.nodeId;
    let bid = b.nodeId;
    let aSh = a.shape;
    let bSh = b.shape;
    customVjp([aid, bid], out, (g: Tensor) -> [(aid, unbroadcastRaw(g, aSh)), (bid, unbroadcastRaw(g, bSh))])
}

pub def sub(a: Tensor, b: Tensor): Tensor = {
    let out = rawBinop(1, a, b);
    let aid = a.nodeId;
    let bid = b.nodeId;
    let aSh = a.shape;
    let bSh = b.shape;
    customVjp([aid, bid], out, (g: Tensor) -> {
        let ng = allocTensorOn(g.shape, g.device);
        c_scale(devKind(g.device), devId(g.device), g.buf, floatToF32(-1.0), ng.buf, intToI64(g.numel));
        [(aid, unbroadcastRaw(g, aSh)), (bid, unbroadcastRaw(ng, bSh))]
    })
}

pub def mul(a: Tensor, b: Tensor): Tensor = {
    let out = rawBinop(2, a, b);
    let aid = a.nodeId;
    let bid = b.nodeId;
    let ad = detach(a);
    let bd = detach(b);
    customVjp([aid, bid], out, (g: Tensor) -> {
        let ga = unbroadcastRaw(rawBinop(2, g, bd), ad.shape);
        let gb = unbroadcastRaw(rawBinop(2, g, ad), bd.shape);
        [(aid, ga), (bid, gb)]
    })
}

pub def divT(a: Tensor, b: Tensor): Tensor = {
    let out = rawBinop(3, a, b);
    let aid = a.nodeId;
    let bid = b.nodeId;
    let ad = detach(a);
    let bd = detach(b);
    customVjp([aid, bid], out, (g: Tensor) -> {
        // d(a/b)/da = g / b, d(a/b)/db = -g * a / (b * b)
        let ga = unbroadcastRaw(rawBinop(3, g, bd), ad.shape);
        let b2 = rawBinop(2, bd, bd);
        let gaRaw = rawBinop(3, rawBinop(2, g, ad), b2);
        let gbNeg = allocTensorOn(gaRaw.shape, gaRaw.device);
        c_scale(devKind(gaRaw.device), devId(gaRaw.device), gaRaw.buf, floatToF32(-1.0), gbNeg.buf, intToI64(gaRaw.numel));
        [(aid, ga), (bid, unbroadcastRaw(gbNeg, bd.shape))]
    })
}

pub def scale(a: Tensor, s: Float): Tensor = {
    let out = allocTensorOn(a.shape, a.device);
    c_scale(devKind(a.device), devId(a.device), a.buf, floatToF32(s), out.buf, intToI64(a.numel));
    let aid = a.nodeId;
    customVjp([aid], out, (g: Tensor) -> {
        let ga = allocTensorOn(g.shape, g.device);
        c_scale(devKind(g.device), devId(g.device), g.buf, floatToF32(s), ga.buf, intToI64(g.numel));
        [(aid, ga)]
    })
}

pub def addScalar(a: Tensor, s: Float): Tensor = {
    let out = allocTensorOn(a.shape, a.device);
    c_add_scalar(devKind(a.device), devId(a.device), a.buf, floatToF32(s), out.buf, intToI64(a.numel));
    let aid = a.nodeId;
    customVjp([aid], out, (g: Tensor) -> [(aid, g)])
}

pub def powScalar(a: Tensor, p: Float): Tensor = {
    let out = allocTensorOn(a.shape, a.device);
    let dk = devKind(a.device);
    let did = devId(a.device);
    c_pow_scalar_fwd(dk, did, a.buf, floatToF32(p), out.buf, intToI64(a.numel));
    let aid = a.nodeId;
    let ad = detach(a);
    customVjp([aid], out, (g: Tensor) -> {
        let ga = allocTensorOn(ad.shape, g.device);
        c_pow_scalar_bwd(dk, did, ad.buf, g.buf, floatToF32(p), ga.buf, intToI64(ad.numel));
        [(aid, ga)]
    })
}

pub def clamp(a: Tensor, lo: Float, hi: Float): Tensor = {
    let out = allocTensorOn(a.shape, a.device);
    let dk = devKind(a.device);
    let did = devId(a.device);
    c_clamp_fwd(dk, did, a.buf, floatToF32(lo), floatToF32(hi), out.buf, intToI64(a.numel));
    let aid = a.nodeId;
    let ad = detach(a);
    customVjp([aid], out, (g: Tensor) -> {
        let ga = allocTensorOn(ad.shape, g.device);
        c_clamp_bwd(dk, did, ad.buf, g.buf, floatToF32(lo), floatToF32(hi), ga.buf, intToI64(ad.numel));
        [(aid, ga)]
    })
}

pub def leakyRelu(a: Tensor, slope: Float): Tensor = {
    let out = allocTensorOn(a.shape, a.device);
    let dk = devKind(a.device);
    let did = devId(a.device);
    c_leaky_relu_fwd(dk, did, a.buf, floatToF32(slope), out.buf, intToI64(a.numel));
    let aid = a.nodeId;
    let ad = detach(a);
    customVjp([aid], out, (g: Tensor) -> {
        let ga = allocTensorOn(ad.shape, g.device);
        c_leaky_relu_bwd(dk, did, ad.buf, g.buf, floatToF32(slope), ga.buf, intToI64(ad.numel));
        [(aid, ga)]
    })
}

pub def negT(a: Tensor): Tensor = scale(a, -1.0)

instance Add Tensor Tensor Tensor { def (+)(a, b) = add(a, b) }
instance Sub Tensor Tensor Tensor { def (-)(a, b) = sub(a, b) }
instance Mul Tensor Tensor Tensor { def (*)(a, b) = mul(a, b) }
instance Div Tensor Tensor Tensor { def (/)(a, b) = divT(a, b) }
instance Neg Tensor { def neg(a) = negT(a) }

// ============================================================================
// Unary Math & Activations
// ============================================================================

def unaryOp(op: Int, x: Tensor): Tensor = {
    let out = allocTensorOn(x.shape, x.device);
    let dk = devKind(x.device);
    let did = devId(x.device);
    c_unary_fwd(dk, did, op, x.buf, out.buf, intToI64(x.numel));
    let xid = x.nodeId;
    let xd = detach(x);
    let yd = detach(out);
    customVjp([xid], out, (g: Tensor) -> {
        let gx = allocTensorOn(xd.shape, g.device);
        c_unary_bwd(dk, did, op, xd.buf, yd.buf, g.buf, gx.buf, intToI64(xd.numel));
        [(xid, gx)]
    })
}

pub def exp(x: Tensor): Tensor = unaryOp(0, x)
pub def log(x: Tensor): Tensor = unaryOp(1, x)
pub def sqrt(x: Tensor): Tensor = unaryOp(2, x)
pub def rsqrt(x: Tensor): Tensor = unaryOp(3, x)
pub def abs(x: Tensor): Tensor = unaryOp(4, x)
pub def square(x: Tensor): Tensor = unaryOp(5, x)
pub def tanh(x: Tensor): Tensor = unaryOp(6, x)
pub def sigmoid(x: Tensor): Tensor = unaryOp(7, x)
pub def round(x: Tensor): Tensor = unaryOp(8, x)
pub def silu(x: Tensor): Tensor = unaryOp(9, x)
pub def gelu(x: Tensor): Tensor = unaryOp(10, x)
pub def relu(x: Tensor): Tensor = unaryOp(11, x)

pub def softplus(x: Tensor): Tensor = log(addScalar(exp(x), 1.0))

// ============================================================================
// Linear Algebra
// ============================================================================

def replaceLastDim(sh: List Int, newLast: Int): List Int = match sh {
    Nil -> [newLast],
    Cons(_, Nil) -> [newLast],
    Cons(h, r) -> Cons(h, replaceLastDim(r, newLast)),
}

pub def matmul(a: Tensor, b: Tensor): Tensor = {
    let m = dimAt(a.shape, 0);
    let k = dimAt(a.shape, 1);
    let n = dimAt(b.shape, 1);
    let out = allocTensorOn([m, n], a.device);
    let dk = devKind(a.device);
    let did = devId(a.device);
    c_sgemm(dk, did, 0, 0, m, n, k, floatToF32(1.0), a.buf, b.buf, floatToF32(0.0), out.buf);
    let aid = a.nodeId;
    let bid = b.nodeId;
    let ad = detach(a);
    let bd = detach(b);
    customVjp([aid, bid], out, (g: Tensor) -> {
        let ga = allocTensorOn([m, k], g.device);
        let gb = allocTensorOn([k, n], g.device);
        c_sgemm(dk, did, 0, 1, m, k, n, floatToF32(1.0), g.buf, bd.buf, floatToF32(0.0), ga.buf);
        c_sgemm(dk, did, 1, 0, k, n, m, floatToF32(1.0), ad.buf, g.buf, floatToF32(0.0), gb.buf);
        [(aid, ga), (bid, gb)]
    })
}

pub def matmulNT(x: Tensor, w: Tensor): Tensor = {
    let outDim = dimAt(w.shape, 0);
    let inDim = dimAt(w.shape, 1);
    let rows = x.numel / inDim;
    let outShape = replaceLastDim(x.shape, outDim);
    let out = allocTensorOn(outShape, x.device);
    let dk = devKind(x.device);
    let did = devId(x.device);
    c_sgemm(dk, did, 0, 1, rows, outDim, inDim, floatToF32(1.0), x.buf, w.buf, floatToF32(0.0), out.buf);
    let xid = x.nodeId;
    let wid = w.nodeId;
    let xd = detach(x);
    let wd = detach(w);
    customVjp([xid, wid], out, (g: Tensor) -> {
        let gx = allocTensorOn(xd.shape, g.device);
        let gw = allocTensorOn(wd.shape, g.device);
        c_sgemm(dk, did, 0, 0, rows, inDim, outDim, floatToF32(1.0), g.buf, wd.buf, floatToF32(0.0), gx.buf);
        c_sgemm(dk, did, 1, 0, outDim, inDim, rows, floatToF32(1.0), g.buf, xd.buf, floatToF32(0.0), gw.buf);
        [(xid, gx), (wid, gw)]
    })
}

pub def bgemm(a: Tensor, b: Tensor): Tensor = {
    let batch = dimAt(a.shape, 0);
    let m = dimAt(a.shape, 1);
    let k = dimAt(a.shape, 2);
    let n = dimAt(b.shape, 2);
    let out = allocTensorOn([batch, m, n], a.device);
    let dk = devKind(a.device);
    let did = devId(a.device);
    c_bgemm(dk, did, batch, 0, 0, m, n, k, floatToF32(1.0), a.buf, b.buf, floatToF32(0.0), out.buf);
    let aid = a.nodeId;
    let bid = b.nodeId;
    let ad = detach(a);
    let bd = detach(b);
    customVjp([aid, bid], out, (g: Tensor) -> {
        let ga = allocTensorOn([batch, m, k], g.device);
        let gb = allocTensorOn([batch, k, n], g.device);
        c_bgemm(dk, did, batch, 0, 1, m, k, n, floatToF32(1.0), g.buf, bd.buf, floatToF32(0.0), ga.buf);
        c_bgemm(dk, did, batch, 1, 0, k, n, m, floatToF32(1.0), ad.buf, g.buf, floatToF32(0.0), gb.buf);
        [(aid, ga), (bid, gb)]
    })
}

pub def bgemmNT(a: Tensor, b: Tensor): Tensor = {
    let batch = dimAt(a.shape, 0);
    let m = dimAt(a.shape, 1);
    let k = dimAt(a.shape, 2);
    let n = dimAt(b.shape, 1);
    let out = allocTensorOn([batch, m, n], a.device);
    let dk = devKind(a.device);
    let did = devId(a.device);
    c_bgemm(dk, did, batch, 0, 1, m, n, k, floatToF32(1.0), a.buf, b.buf, floatToF32(0.0), out.buf);
    let aid = a.nodeId;
    let bid = b.nodeId;
    let ad = detach(a);
    let bd = detach(b);
    customVjp([aid, bid], out, (g: Tensor) -> {
        let ga = allocTensorOn([batch, m, k], g.device);
        let gb = allocTensorOn([batch, n, k], g.device);
        c_bgemm(dk, did, batch, 0, 0, m, k, n, floatToF32(1.0), g.buf, bd.buf, floatToF32(0.0), ga.buf);
        c_bgemm(dk, did, batch, 1, 0, n, k, m, floatToF32(1.0), g.buf, ad.buf, floatToF32(0.0), gb.buf);
        [(aid, ga), (bid, gb)]
    })
}

// ============================================================================
// Shape, Transpose & General Axis Ops (`sliceAxis`, `chunkAxis`, `catAxis`, `padAxis`)
// ============================================================================

pub def reshape(t: Tensor, newShape: List Int): Tensor = {
    let out = Tensor { buf: t.buf, shape: newShape, numel: t.numel, device: t.device, nodeId: -1 };
    let tid = t.nodeId;
    let origShape = t.shape;
    customVjp([tid], out, (g: Tensor) -> [(tid, Tensor { buf: g.buf, shape: origShape, numel: g.numel, device: g.device, nodeId: -1 })])
}

def insertAt(xs: List Int, idx: Int, val: Int): List Int =
    if (idx <= 0) Cons(val, xs)
    else match xs {
        Nil -> [val],
        Cons(h, r) -> Cons(h, insertAt(r, idx - 1, val)),
    }

def removeAt(xs: List Int, idx: Int): List Int = match xs {
    Nil -> Nil,
    Cons(h, r) -> if (idx == 0) r else Cons(h, removeAt(r, idx - 1)),
}

def setAt(xs: List Int, idx: Int, val: Int): List Int = match xs {
    Nil -> Nil,
    Cons(h, r) -> if (idx == 0) Cons(val, r) else Cons(h, setAt(r, idx - 1, val)),
}

pub def unsqueeze(t: Tensor, axis: Int): Tensor = {
    let ax = normalizeAxis(listLen(t.shape) + 1, axis);
    reshape(t, insertAt(t.shape, ax, 1))
}

pub def squeeze(t: Tensor, axis: Int): Tensor = {
    let ax = normalizeAxis(listLen(t.shape), axis);
    if (dimAt(t.shape, ax) == 1) reshape(t, removeAt(t.shape, ax)) else t
}

pub def transpose2d(t: Tensor): Tensor = {
    let r = dimAt(t.shape, 0);
    let c = dimAt(t.shape, 1);
    let out = allocTensorOn([c, r], t.device);
    c_transpose_2d(devKind(t.device), devId(t.device), t.buf, out.buf, r, c);
    let tid = t.nodeId;
    customVjp([tid], out, (g: Tensor) -> {
        let gx = allocTensorOn([r, c], g.device);
        c_transpose_2d(devKind(g.device), devId(g.device), g.buf, gx.buf, c, r);
        [(tid, gx)]
    })
}

pub def transpose0213(t: Tensor): Tensor = {
    let d0 = dimAt(t.shape, 0);
    let d1 = dimAt(t.shape, 1);
    let d2 = dimAt(t.shape, 2);
    let d3 = dimAt(t.shape, 3);
    let out = allocTensorOn([d0, d2, d1, d3], t.device);
    c_transpose_0213(devKind(t.device), devId(t.device), t.buf, out.buf, d0, d1, d2, d3);
    let tid = t.nodeId;
    customVjp([tid], out, (g: Tensor) -> {
        let gx = allocTensorOn([d0, d1, d2, d3], g.device);
        c_transpose_0213(devKind(g.device), devId(g.device), g.buf, gx.buf, d0, d2, d1, d3);
        [(tid, gx)]
    })
}

def axisOuterInner(sh: List Int, ax: Int): (Int, Int, Int) = {
    let outer = cellNew(1);
    let dim = cellNew(1);
    let inner = cellNew(1);
    let cur = cellNew(sh);
    let i = cellNew(0);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(d, r) -> {
                if (cellGet(i) < ax) cellSet(outer, cellGet(outer) * d)
                else if (cellGet(i) == ax) cellSet(dim, d)
                else cellSet(inner, cellGet(inner) * d);
                cellSet(i, cellGet(i) + 1);
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    (cellGet(outer), cellGet(dim), cellGet(inner))
}

pub def sliceAxis(x: Tensor, axis: Int, start: Int, len: Int): Tensor = {
    let ax = normalizeAxis(listLen(x.shape), axis);
    let (outer, inDim, inner) = axisOuterInner(x.shape, ax);
    let outSh = setAt(x.shape, ax, len);
    let out = allocTensorOn(outSh, x.device);
    let dk = devKind(x.device);
    let did = devId(x.device);
    c_slice_axis_fwd(dk, did, x.buf, out.buf, outer, inDim, inner, start, len);
    let xid = x.nodeId;
    let xSh = x.shape;
    customVjp([xid], out, (g: Tensor) -> {
        let gx = allocTensorOn(xSh, g.device);
        c_slice_axis_bwd(dk, did, g.buf, gx.buf, outer, inDim, inner, start, len);
        [(xid, gx)]
    })
}

pub def chunkAxis(x: Tensor, axis: Int, nChunks: Int): List Tensor = {
    let ax = normalizeAxis(listLen(x.shape), axis);
    let dim = dimAt(x.shape, ax);
    let step = dim / nChunks;
    let acc = cellNew(Nil);
    let i = cellNew(0);
    while (cellGet(i) < nChunks) {
        let part = sliceAxis(x, ax, cellGet(i) * step, step);
        cellSet(acc, Cons(part, cellGet(acc)));
        cellSet(i, cellGet(i) + 1)
    };
    listRev(cellGet(acc))
}

pub def catAxis(xs: List Tensor, axis: Int): Tensor = match xs {
    Nil -> zerosOn([0], Cpu),
    Cons(first, Nil) -> first,
    Cons(first, _) -> {
        let ax = normalizeAxis(listLen(first.shape), axis);
        let totalDim = cellNew(0);
        let idsRev = cellNew(Nil);
        let cur = cellNew(xs);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(t, r) -> {
                    cellSet(totalDim, cellGet(totalDim) + dimAt(t.shape, ax));
                    cellSet(idsRev, Cons(t.nodeId, cellGet(idsRev)));
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        let outDim = cellGet(totalDim);
        let outSh = setAt(first.shape, ax, outDim);
        let (outer, _, inner) = axisOuterInner(outSh, ax);
        let out = allocTensorOn(outSh, first.device);
        let dk = devKind(first.device);
        let did = devId(first.device);
        let off = cellNew(0);
        let cur2 = cellNew(xs);
        while (match cellGet(cur2) { Nil -> false, _ -> true }) {
            match cellGet(cur2) {
                Cons(t, r) -> {
                    let len = dimAt(t.shape, ax);
                    // Copy `t` into `out` at [off .. off + len) along `ax`
                    // Reuse slice_axis_bwd? Note slice_axis_bwd zeroes gx, so copy into a temp or use a loop via slice?
                    // Simpler: slice_axis_bwd only zeroes on single slice; for multi-chunk cat we copy per chunk via axpy on a zeroed buffer or direct slice!
                    let tmp = allocTensorOn(outSh, first.device);
                    c_slice_axis_bwd(dk, did, t.buf, tmp.buf, outer, outDim, inner, cellGet(off), len);
                    axpyInPlace(1.0, tmp, out);
                    cellSet(off, cellGet(off) + len);
                    cellSet(cur2, r)
                },
                Nil -> (),
            }
        };
        let specsRev = cellNew(Nil);
        let off2 = cellNew(0);
        let cur3 = cellNew(xs);
        while (match cellGet(cur3) { Nil -> false, _ -> true }) {
            match cellGet(cur3) {
                Cons(t, r) -> {
                    let len = dimAt(t.shape, ax);
                    cellSet(specsRev, Cons((t.nodeId, cellGet(off2), len, t.shape), cellGet(specsRev)));
                    cellSet(off2, cellGet(off2) + len);
                    cellSet(cur3, r)
                },
                Nil -> (),
            }
        };
        let specs = listRev(cellGet(specsRev));
        customVjp(listRev(cellGet(idsRev)), out, (g: Tensor) -> {
            let resRev = cellNew(Nil);
            let cs = cellNew(specs);
            while (match cellGet(cs) { Nil -> false, _ -> true }) {
                match cellGet(cs) {
                    Cons((tid, st, ln, tSh), rs) -> {
                        let gt = allocTensorOn(tSh, g.device);
                        c_slice_axis_fwd(dk, did, g.buf, gt.buf, outer, outDim, inner, st, ln);
                        cellSet(resRev, Cons((tid, gt), cellGet(resRev)));
                        cellSet(cs, rs)
                    },
                    Nil -> (),
                }
            };
            listRev(cellGet(resRev))
        })
    },
}

pub def padAxis(x: Tensor, axis: Int, padLeft: Int, padRight: Int, val: Float): Tensor = {
    let ax = normalizeAxis(listLen(x.shape), axis);
    let parts = cellNew([x]);
    if (padRight > 0) {
        let rSh = setAt(x.shape, ax, padRight);
        cellSet(parts, [x, fullOn(rSh, val, x.device)])
    } else ();
    if (padLeft > 0) {
        let lSh = setAt(x.shape, ax, padLeft);
        cellSet(parts, Cons(fullOn(lSh, val, x.device), cellGet(parts)))
    } else ();
    catAxis(cellGet(parts), ax)
}

// ============================================================================
// Reductions
// ============================================================================

pub def sumAll(x: Tensor): Tensor = {
    let v = f32ToFloat(c_sum_all(devKind(x.device), devId(x.device), x.buf, intToI64(x.numel)));
    let out = fullOn([1], v, x.device);
    let xid = x.nodeId;
    let xShape = x.shape;
    let xDev = x.device;
    customVjp([xid], out, (g: Tensor) -> [(xid, fullOn(xShape, item(g), xDev))])
}

pub def meanAll(x: Tensor): Tensor = scale(sumAll(x), 1.0 / intToFloat(x.numel))

pub def sumAxis(x: Tensor, axis: Int, keepDim: Bool): Tensor = {
    let ax = normalizeAxis(listLen(x.shape), axis);
    let (outer, dim, inner) = axisOuterInner(x.shape, ax);
    let keepSh = setAt(x.shape, ax, 1);
    let outSh = if (keepDim) keepSh else removeAt(x.shape, ax);
    let out = allocTensorOn(outSh, x.device);
    c_sum_axis(devKind(x.device), devId(x.device), x.buf, out.buf, outer, dim, inner);
    let xid = x.nodeId;
    let xSh = x.shape;
    customVjp([xid], out, (g: Tensor) -> {
        let gKeep = Tensor { buf: g.buf, shape: keepSh, numel: g.numel, device: g.device, nodeId: -1 };
        let z = zerosOn(xSh, g.device);
        [(xid, rawBinop(0, z, gKeep))]
    })
}

pub def meanAxis(x: Tensor, axis: Int, keepDim: Bool): Tensor = {
    let ax = normalizeAxis(listLen(x.shape), axis);
    let d = dimAt(x.shape, ax);
    scale(sumAxis(x, ax, keepDim), 1.0 / intToFloat(d))
}

pub def maxAxis(x: Tensor, axis: Int, keepDim: Bool): Tensor = {
    let ax = normalizeAxis(listLen(x.shape), axis);
    let (outer, dim, inner) = axisOuterInner(x.shape, ax);
    let outSh = if (keepDim) setAt(x.shape, ax, 1) else removeAt(x.shape, ax);
    let out = allocTensorOn(outSh, x.device);
    c_max_axis(devKind(x.device), devId(x.device), x.buf, out.buf, outer, dim, inner);
    out
}

pub def logSumExpLast(x: Tensor): Tensor = {
    let rank = listLen(x.shape);
    let cols = dimAt(x.shape, rank - 1);
    let rows = x.numel / cols;
    let outSh = removeAt(x.shape, rank - 1);
    let out = allocTensorOn(if (listLen(outSh) == 0) [1] else outSh, x.device);
    let dk = devKind(x.device);
    let did = devId(x.device);
    c_log_sum_exp_fwd(dk, did, x.buf, out.buf, rows, cols);
    let xid = x.nodeId;
    let xd = detach(x);
    let lseD = detach(out);
    customVjp([xid], out, (g: Tensor) -> {
        let gx = allocTensorOn(xd.shape, g.device);
        c_log_sum_exp_bwd(dk, did, xd.buf, lseD.buf, g.buf, gx.buf, rows, cols);
        [(xid, gx)]
    })
}

pub def sumSqFloat(x: Tensor): Float =
    f32ToFloat(c_sum_sq(devKind(x.device), devId(x.device), x.buf, intToI64(x.numel)))

pub def l2NormFloat(x: Tensor): Float =
    f32ToFloat(mathSqrtF32(floatToF32(sumSqFloat(x))))

// ============================================================================
// Norms, Softmax, Losses, Embedding, RoPE & Causal Mask
// ============================================================================

pub def rmsNorm(x: Tensor, w: Tensor, eps: Float): Tensor = {
    let dim = w.numel;
    let rows = x.numel / dim;
    let out = allocTensorOn(x.shape, x.device);
    let dk = devKind(x.device);
    let did = devId(x.device);
    c_rms_norm_fwd(dk, did, x.buf, w.buf, out.buf, rows, dim, floatToF32(eps));
    let xid = x.nodeId;
    let wid = w.nodeId;
    let xd = detach(x);
    let wd = detach(w);
    customVjp([xid, wid], out, (g: Tensor) -> {
        let gx = allocTensorOn(xd.shape, g.device);
        let gw = allocTensorOn(wd.shape, g.device);
        c_rms_norm_bwd(dk, did, xd.buf, wd.buf, g.buf, gx.buf, gw.buf, rows, dim, floatToF32(eps));
        [(xid, gx), (wid, gw)]
    })
}

pub def layerNorm(x: Tensor, w: Tensor, b: Tensor, eps: Float): Tensor = {
    let dim = w.numel;
    let rows = x.numel / dim;
    let out = allocTensorOn(x.shape, x.device);
    let dk = devKind(x.device);
    let did = devId(x.device);
    c_layer_norm_fwd(dk, did, x.buf, w.buf, b.buf, out.buf, rows, dim, floatToF32(eps));
    let xid = x.nodeId;
    let wid = w.nodeId;
    let bid = b.nodeId;
    let xd = detach(x);
    let wd = detach(w);
    let bSh = b.shape;
    customVjp([xid, wid, bid], out, (g: Tensor) -> {
        let gx = allocTensorOn(xd.shape, g.device);
        let gw = allocTensorOn(wd.shape, g.device);
        let gb = allocTensorOn(bSh, g.device);
        c_layer_norm_bwd(dk, did, xd.buf, wd.buf, g.buf, gx.buf, gw.buf, gb.buf, rows, dim, floatToF32(eps));
        [(xid, gx), (wid, gw), (bid, gb)]
    })
}

pub def l2NormLast(x: Tensor, eps: Float): Tensor = {
    let cols = dimAt(x.shape, listLen(x.shape) - 1);
    let rows = x.numel / cols;
    let out = allocTensorOn(x.shape, x.device);
    let dk = devKind(x.device);
    let did = devId(x.device);
    c_l2_norm_last_fwd(dk, did, x.buf, out.buf, rows, cols, floatToF32(eps));
    let xid = x.nodeId;
    let xd = detach(x);
    customVjp([xid], out, (g: Tensor) -> {
        let gx = allocTensorOn(xd.shape, g.device);
        c_l2_norm_last_bwd(dk, did, xd.buf, g.buf, gx.buf, rows, cols, floatToF32(eps));
        [(xid, gx)]
    })
}

pub def softmax(x: Tensor): Tensor = {
    let cols = dimAt(x.shape, listLen(x.shape) - 1);
    let rows = x.numel / cols;
    let out = allocTensorOn(x.shape, x.device);
    let dk = devKind(x.device);
    let did = devId(x.device);
    c_softmax_fwd(dk, did, x.buf, out.buf, rows, cols);
    let xid = x.nodeId;
    let yd = detach(out);
    customVjp([xid], out, (g: Tensor) -> {
        let gx = allocTensorOn(yd.shape, g.device);
        c_softmax_bwd(dk, did, yd.buf, g.buf, gx.buf, rows, cols);
        [(xid, gx)]
    })
}

pub def logSoftmax(x: Tensor): Tensor = {
    let lse = unsqueeze(logSumExpLast(x), -1);
    sub(x, lse)
}

pub def crossEntropyIgnore(logits: Tensor, targets: IntTensor, ignoreIndex: Int): Tensor = {
    let vocab = dimAt(logits.shape, listLen(logits.shape) - 1);
    let rows = logits.numel / vocab;
    let probs = allocTensorOn(logits.shape, logits.device);
    let dk = devKind(logits.device);
    let did = devId(logits.device);
    let lossVal = f32ToFloat(c_ce_fwd(dk, did, logits.buf, targets.buf, probs.buf, rows, vocab, ignoreIndex));
    let out = fullOn([1], lossVal, logits.device);
    let lid = logits.nodeId;
    let lShape = logits.shape;
    customVjp([lid], out, (g: Tensor) -> {
        let gl = allocTensorOn(lShape, logits.device);
        c_ce_bwd(dk, did, probs.buf, targets.buf, floatToF32(item(g)), gl.buf, rows, vocab, ignoreIndex);
        [(lid, gl)]
    })
}

pub def crossEntropy(logits: Tensor, targets: IntTensor): Tensor =
    crossEntropyIgnore(logits, targets, -100)

pub def mseLoss(pred: Tensor, target: Tensor): Tensor =
    meanAll(square(sub(pred, target)))

pub def embedding(table: Tensor, ids: IntTensor): Tensor = {
    let vocab = dimAt(table.shape, 0);
    let dim = dimAt(table.shape, 1);
    let nIds = ids.numel;
    let outShape = listRev(Cons(dim, listRev(ids.shape)));
    let out = allocTensorOn(outShape, table.device);
    let dk = devKind(table.device);
    let did = devId(table.device);
    c_emb_fwd(dk, did, table.buf, ids.buf, out.buf, nIds, dim);
    let tid = table.nodeId;
    customVjp([tid], out, (g: Tensor) -> {
        let gt = allocTensorOn([vocab, dim], table.device);
        c_emb_bwd(dk, did, ids.buf, g.buf, gt.buf, nIds, vocab, dim);
        [(tid, gt)]
    })
}

pub def rope(x: Tensor, theta: Float): Tensor = {
    let b = dimAt(x.shape, 0);
    let s = dimAt(x.shape, 1);
    let h = dimAt(x.shape, 2);
    let hd = dimAt(x.shape, 3);
    let out = allocTensorOn(x.shape, x.device);
    let dk = devKind(x.device);
    let did = devId(x.device);
    c_rope_fwd(dk, did, x.buf, out.buf, b, s, h, hd, floatToF32(theta));
    let xid = x.nodeId;
    customVjp([xid], out, (g: Tensor) -> {
        let gx = allocTensorOn([b, s, h, hd], g.device);
        c_rope_bwd(dk, did, g.buf, gx.buf, b, s, h, hd, floatToF32(theta));
        [(xid, gx)]
    })
}

pub def causalMask(scores: Tensor): Tensor = {
    let bh = dimAt(scores.shape, 0);
    let seq = dimAt(scores.shape, 1);
    let out = cloneTensor(scores);
    c_causal_mask_add(devKind(scores.device), devId(scores.device), out.buf, bh, seq);
    let sid = scores.nodeId;
    customVjp([sid], out, (g: Tensor) -> [(sid, g)])
}
