// Universal differentiable Tensor operations (`tensor.ops`).
// Pure-Geisha CPU kernels (`tensor.cpu`) + vendor BLAS GEMM (`tensor.backend`).

use std.option.{Option, Some, None}
use std.list.{listLen, listRev}
use tensor.backend.{Device, Cpu, devId, sgemmCpu, bgemmCpu}
use tensor.cpu.{
    cpuBinopSame, cpuScale, cpuAddScalar, cpuPowScalarFwd, cpuPowScalarBwd,
    cpuClampFwd, cpuClampBwd, cpuLeakyReluFwd, cpuLeakyReluBwd,
    cpuBcastBinop, cpuBcastReduceSum, cpuUnaryFwd, cpuUnaryBwd,
    cpuSliceAxisFwd, cpuSliceAxisBwd, cpuSumAxis, cpuMaxAxis, cpuSumAll, cpuSumSq,
    cpuRmsNormFwd, cpuRmsNormBwd, cpuLayerNormFwd, cpuLayerNormBwd,
    cpuL2NormLastFwd, cpuL2NormLastBwd, cpuSoftmaxFwd, cpuSoftmaxBwd,
    cpuLogSumExpFwd, cpuLogSumExpBwd, cpuCrossEntropyFwd, cpuCrossEntropyBwd,
    cpuEmbeddingFwd, cpuEmbeddingBwd, cpuRope,
    cpuTranspose2d, cpuTranspose0213, cpuCausalMaskAdd
}
use tensor.cuda.{
    cudaSgemm, cudaBgemm, cudaBinopSame, cudaScale, cudaAddScalar,
    cudaPowScalarFwd, cudaPowScalarBwd, cudaClampFwd, cudaClampBwd,
    cudaLeakyReluFwd, cudaLeakyReluBwd, cudaBcastBinop, cudaBcastReduceSum,
    cudaUnaryFwd, cudaUnaryBwd, cudaSliceAxisFwd, cudaSliceAxisBwd,
    cudaSumAxis, cudaMaxAxis, cudaSumAll, cudaSumSq,
    cudaRmsNormFwd, cudaRmsNormBwd, cudaLayerNormFwd, cudaLayerNormBwd,
    cudaL2NormLastFwd, cudaL2NormLastBwd, cudaSoftmaxFwd, cudaSoftmaxBwd,
    cudaLogSumExpFwd, cudaLogSumExpBwd, cudaCrossEntropyFwd, cudaCrossEntropyBwd,
    cudaEmbeddingFwd, cudaEmbeddingBwd, cudaRope,
    cudaTranspose2d, cudaTranspose0213, cudaCausalMaskAdd
}
use tensor.tensor.{
    Tensor, IntTensor, allocTensorOn, fullOn, zerosOn, cloneTensor, detach, item, axpyInPlace,
    shapeEq, dimAt, normalizeAxis, broadcastShape, broadcastStrides, packI32List, customVjp,
    isMetal, isCuda, syncDevice,
    IrOp, IrBin, IrUnary, IrScale, IrAddScalar, IrPowScalar, IrClamp, IrLeakyRelu,
    JitTrace, getActiveJitTrace, jitPushScalar, jitRecordNode
}
use tensor.metal.{
    metalSgemm, metalBgemm, metalBinopSame, metalScaleOrAxpy, metalUnary2, metalUnary3
}

// ============================================================================
// Internal Broadcasting & Reduction Helpers
// ============================================================================

def unbroadcastRaw(g: Tensor, targetShape: List Int): Tensor =
    if (shapeEq(g.shape, targetShape)) g
    else {
        let out = allocTensorOn(targetShape, g.device);
        let nd = listLen(g.shape);
        let shBuf = packI32List(g.shape);
        let stBuf = packI32List(broadcastStrides(targetShape, g.shape));
        if (isCuda(g.device)) cudaBcastReduceSum(devId(g.device), nd, g.numel, out.numel, shBuf, stBuf, g.buf, out.buf)
        else {
            syncDevice(g.device);
            cpuBcastReduceSum(nd, g.numel, out.numel, shBuf, stBuf, g.buf, out.buf)
        };
        out
    }

def rawBinop(op: Int, a: Tensor, b: Tensor): Tensor =
    if (shapeEq(a.shape, b.shape)) {
        let out = allocTensorOn(a.shape, a.device);
        if (isCuda(a.device)) cudaBinopSame(devId(a.device), op, a.buf, b.buf, out.buf, a.numel)
        else if (isMetal(a.device)) metalBinopSame(op, a.gpuBuf, b.gpuBuf, out.gpuBuf, a.numel)
        else cpuBinopSame(op, a.buf, b.buf, out.buf, a.numel);
        out
    } else {
        let outSh = broadcastShape(a.shape, b.shape);
        let out = allocTensorOn(outSh, a.device);
        let shBuf = packI32List(outSh);
        let saBuf = packI32List(broadcastStrides(a.shape, outSh));
        let sbBuf = packI32List(broadcastStrides(b.shape, outSh));
        if (isCuda(a.device)) cudaBcastBinop(devId(a.device), op, listLen(outSh), out.numel, shBuf, saBuf, sbBuf, a.buf, b.buf, out.buf)
        else {
            syncDevice(a.device);
            cpuBcastBinop(op, listLen(outSh), out.numel, shBuf, saBuf, sbBuf, a.buf, b.buf, out.buf)
        };
        out
    }

def rawScaleTensor(a: Tensor, s: Float): Tensor = {
    let out = allocTensorOn(a.shape, a.device);
    if (isCuda(a.device)) cudaScale(devId(a.device), a.buf, floatToF32(s), out.buf, a.numel)
    else if (isMetal(a.device)) metalScaleOrAxpy("k_scale", a.gpuBuf, out.gpuBuf, floatToF32(s), a.numel)
    else cpuScale(a.buf, floatToF32(s), out.buf, a.numel);
    out
}

def tryJitBin(op: Int, a: Tensor, b: Tensor, eager: () -> Tensor): Tensor =
    match getActiveJitTrace() {
        Some(tr) -> if (a.irId >= 0 && b.irId >= 0 && shapeEq(a.shape, b.shape))
            jitRecordNode(tr, IrBin(op, a.irId, b.irId), a.shape, a.device)
        else eager(),
        None -> eager(),
    }

def tryJitUnary(x: Tensor, mkOp: JitTrace -> IrOp, eager: () -> Tensor): Tensor =
    match getActiveJitTrace() {
        Some(tr) -> if (x.irId >= 0) jitRecordNode(tr, mkOp(tr), x.shape, x.device)
        else eager(),
        None -> eager(),
    }

// ============================================================================
// Broadcasting Arithmetic (`+`, `-`, `*`, `/`, `-x`) & Scalar Ops
// ============================================================================

pub def add(a: Tensor, b: Tensor): Tensor =
    tryJitBin(0, a, b, () -> {
        let out = rawBinop(0, a, b);
        let aid = a.nodeId; let bid = b.nodeId; let aSh = a.shape; let bSh = b.shape;
        customVjp([aid, bid], out, (g: Tensor) -> [(aid, unbroadcastRaw(g, aSh)), (bid, unbroadcastRaw(g, bSh))])
    })

pub def sub(a: Tensor, b: Tensor): Tensor =
    tryJitBin(1, a, b, () -> {
        let out = rawBinop(1, a, b);
        let aid = a.nodeId; let bid = b.nodeId; let aSh = a.shape; let bSh = b.shape;
        customVjp([aid, bid], out, (g: Tensor) -> {
            let ng = rawScaleTensor(g, -1.0);
            [(aid, unbroadcastRaw(g, aSh)), (bid, unbroadcastRaw(ng, bSh))]
        })
    })

pub def mul(a: Tensor, b: Tensor): Tensor =
    tryJitBin(2, a, b, () -> {
        let out = rawBinop(2, a, b);
        let aid = a.nodeId; let bid = b.nodeId; let ad = detach(a); let bd = detach(b);
        customVjp([aid, bid], out, (g: Tensor) -> {
            let ga = unbroadcastRaw(rawBinop(2, g, bd), ad.shape);
            let gb = unbroadcastRaw(rawBinop(2, g, ad), bd.shape);
            [(aid, ga), (bid, gb)]
        })
    })

pub def divT(a: Tensor, b: Tensor): Tensor =
    tryJitBin(3, a, b, () -> {
        let out = rawBinop(3, a, b);
        let aid = a.nodeId; let bid = b.nodeId; let ad = detach(a); let bd = detach(b);
        customVjp([aid, bid], out, (g: Tensor) -> {
            let ga = unbroadcastRaw(rawBinop(3, g, bd), ad.shape);
            let b2 = rawBinop(2, bd, bd);
            let gaRaw = rawBinop(3, rawBinop(2, g, ad), b2);
            let gbNeg = rawScaleTensor(gaRaw, -1.0);
            [(aid, ga), (bid, unbroadcastRaw(gbNeg, bd.shape))]
        })
    })

pub def scale(a: Tensor, s: Float): Tensor =
    tryJitUnary(a, (tr: JitTrace) -> IrScale(a.irId, jitPushScalar(tr, s)), () -> {
        let out = rawScaleTensor(a, s);
        let aid = a.nodeId;
        customVjp([aid], out, (g: Tensor) -> [(aid, rawScaleTensor(g, s))])
    })

pub def addScalar(a: Tensor, s: Float): Tensor =
    tryJitUnary(a, (tr: JitTrace) -> IrAddScalar(a.irId, jitPushScalar(tr, s)), () -> {
        let out = allocTensorOn(a.shape, a.device);
        if (isCuda(a.device)) cudaAddScalar(devId(a.device), a.buf, floatToF32(s), out.buf, a.numel)
        else { syncDevice(a.device); cpuAddScalar(a.buf, floatToF32(s), out.buf, a.numel) };
        let aid = a.nodeId;
        customVjp([aid], out, (g: Tensor) -> [(aid, g)])
    })

pub def powScalar(a: Tensor, p: Float): Tensor =
    tryJitUnary(a, (tr: JitTrace) -> IrPowScalar(a.irId, jitPushScalar(tr, p)), () -> {
        let out = allocTensorOn(a.shape, a.device);
        if (isCuda(a.device)) cudaPowScalarFwd(devId(a.device), a.buf, floatToF32(p), out.buf, a.numel)
        else { syncDevice(a.device); cpuPowScalarFwd(a.buf, floatToF32(p), out.buf, a.numel) };
        let aid = a.nodeId; let ad = detach(a);
        customVjp([aid], out, (g: Tensor) -> {
            let ga = allocTensorOn(ad.shape, g.device);
            if (isCuda(g.device)) cudaPowScalarBwd(devId(g.device), ad.buf, g.buf, floatToF32(p), ga.buf, ad.numel)
            else { syncDevice(g.device); cpuPowScalarBwd(ad.buf, g.buf, floatToF32(p), ga.buf, ad.numel) };
            [(aid, ga)]
        })
    })

pub def clamp(a: Tensor, lo: Float, hi: Float): Tensor =
    tryJitUnary(a, (tr: JitTrace) -> {
        let lsi = jitPushScalar(tr, lo);
        let hsi = jitPushScalar(tr, hi);
        IrClamp(a.irId, lsi, hsi)
    }, () -> {
        let out = allocTensorOn(a.shape, a.device);
        if (isCuda(a.device)) cudaClampFwd(devId(a.device), a.buf, floatToF32(lo), floatToF32(hi), out.buf, a.numel)
        else { syncDevice(a.device); cpuClampFwd(a.buf, floatToF32(lo), floatToF32(hi), out.buf, a.numel) };
        let aid = a.nodeId; let ad = detach(a);
        customVjp([aid], out, (g: Tensor) -> {
            let ga = allocTensorOn(ad.shape, g.device);
            if (isCuda(g.device)) cudaClampBwd(devId(g.device), ad.buf, g.buf, floatToF32(lo), floatToF32(hi), ga.buf, ad.numel)
            else { syncDevice(g.device); cpuClampBwd(ad.buf, g.buf, floatToF32(lo), floatToF32(hi), ga.buf, ad.numel) };
            [(aid, ga)]
        })
    })

pub def leakyRelu(a: Tensor, slope: Float): Tensor =
    tryJitUnary(a, (tr: JitTrace) -> IrLeakyRelu(a.irId, jitPushScalar(tr, slope)), () -> {
        let out = allocTensorOn(a.shape, a.device);
        if (isCuda(a.device)) cudaLeakyReluFwd(devId(a.device), a.buf, floatToF32(slope), out.buf, a.numel)
        else { syncDevice(a.device); cpuLeakyReluFwd(a.buf, floatToF32(slope), out.buf, a.numel) };
        let aid = a.nodeId; let ad = detach(a);
        customVjp([aid], out, (g: Tensor) -> {
            let ga = allocTensorOn(ad.shape, g.device);
            if (isCuda(g.device)) cudaLeakyReluBwd(devId(g.device), ad.buf, g.buf, floatToF32(slope), ga.buf, ad.numel)
            else { syncDevice(g.device); cpuLeakyReluBwd(ad.buf, g.buf, floatToF32(slope), ga.buf, ad.numel) };
            [(aid, ga)]
        })
    })

pub def negT(a: Tensor): Tensor = scale(a, -1.0)

instance Add Tensor Tensor Tensor { def (+)(a, b) = add(a, b) }
instance Sub Tensor Tensor Tensor { def (-)(a, b) = sub(a, b) }
instance Mul Tensor Tensor Tensor { def (*)(a, b) = mul(a, b) }
instance Div Tensor Tensor Tensor { def (/)(a, b) = divT(a, b) }
instance Neg Tensor { def neg(a) = negT(a) }

// ============================================================================
// Unary Math & Activations
// ============================================================================

def unaryOp(op: Int, x: Tensor): Tensor =
    tryJitUnary(x, (_: JitTrace) -> IrUnary(op, x.irId), () -> {
        let out = allocTensorOn(x.shape, x.device);
        let useCuda = isCuda(x.device);
        let useMetal = isMetal(x.device) && (op == 7 || op == 9 || op == 11);
        if (useCuda) {
            cudaUnaryFwd(devId(x.device), op, x.buf, out.buf, x.numel)
        } else if (useMetal) {
            let kn = if (op == 7) "k_sigmoid_fwd" else if (op == 9) "k_silu_fwd" else "k_relu_fwd";
            metalUnary2(kn, x.gpuBuf, out.gpuBuf, x.numel)
        } else {
            syncDevice(x.device);
            cpuUnaryFwd(op, x.buf, out.buf, x.numel)
        };
        let xid = x.nodeId; let xd = detach(x); let yd = detach(out);
        customVjp([xid], out, (g: Tensor) -> {
            let gx = allocTensorOn(xd.shape, g.device);
            if (useCuda) {
                cudaUnaryBwd(devId(g.device), op, xd.buf, yd.buf, g.buf, gx.buf, xd.numel)
            } else if (useMetal) {
                if (op == 7) metalUnary3("k_sigmoid_bwd", yd.gpuBuf, g.gpuBuf, gx.gpuBuf, xd.numel)
                else if (op == 9) metalUnary3("k_silu_bwd", xd.gpuBuf, g.gpuBuf, gx.gpuBuf, xd.numel)
                else metalUnary3("k_relu_bwd", xd.gpuBuf, g.gpuBuf, gx.gpuBuf, xd.numel)
            } else {
                syncDevice(g.device);
                cpuUnaryBwd(op, xd.buf, yd.buf, g.buf, gx.buf, xd.numel)
            };
            [(xid, gx)]
        })
    })

pub def exp(x: Tensor): Tensor = unaryOp(0, x)
pub def log(x: Tensor): Tensor = unaryOp(1, x)
pub def sqrt(x: Tensor): Tensor = unaryOp(2, x)
pub def rsqrt(x: Tensor): Tensor = unaryOp(3, x)
pub def abs(x: Tensor): Tensor = unaryOp(4, x)
pub def square(x: Tensor): Tensor = unaryOp(5, x)
pub def tanh(x: Tensor): Tensor = unaryOp(6, x)
pub def sigmoid(x: Tensor): Tensor = unaryOp(7, x)
pub def round(x: Tensor): Tensor = unaryOp(8, x)
pub def silu(x: Tensor): Tensor = unaryOp(9, x)
pub def gelu(x: Tensor): Tensor = unaryOp(10, x)
pub def relu(x: Tensor): Tensor = unaryOp(11, x)
pub def softplus(x: Tensor): Tensor = log(addScalar(exp(x), 1.0))

// ============================================================================
// Linear Algebra (Vendor BLAS SGEMM / BGEMM)
// ============================================================================

def replaceLastDim(sh: List Int, newLast: Int): List Int = match sh {
    Nil -> [newLast],
    Cons(_, Nil) -> [newLast],
    Cons(h, r) -> Cons(h, replaceLastDim(r, newLast)),
}

def dispatchSgemm(ta: Bool, tb: Bool, m: Int, n: Int, k: Int, a: Tensor, b: Tensor, out: Tensor): Void =
    if (isCuda(a.device)) cudaSgemm(devId(a.device), ta, tb, m, n, k, floatToF32(1.0), a.buf, b.buf, floatToF32(0.0), out.buf)
    else if (isMetal(a.device)) metalSgemm(ta, tb, m, n, k, 1.0, a.gpuBuf, b.gpuBuf, 0.0, out.gpuBuf)
    else sgemmCpu(ta, tb, m, n, k, floatToF32(1.0), a.buf, b.buf, floatToF32(0.0), out.buf)

def dispatchBgemm(batch: Int, ta: Bool, tb: Bool, m: Int, n: Int, k: Int, a: Tensor, b: Tensor, out: Tensor): Void =
    if (isCuda(a.device)) cudaBgemm(devId(a.device), batch, ta, tb, m, n, k, floatToF32(1.0), a.buf, b.buf, floatToF32(0.0), out.buf)
    else if (isMetal(a.device)) metalBgemm(batch, ta, tb, m, n, k, 1.0, a.gpuBuf, b.gpuBuf, 0.0, out.gpuBuf)
    else bgemmCpu(batch, ta, tb, m, n, k, floatToF32(1.0), a.buf, b.buf, floatToF32(0.0), out.buf)

pub def matmul(a: Tensor, b: Tensor): Tensor = {
    let m = dimAt(a.shape, 0);
    let k = dimAt(a.shape, 1);
    let n = dimAt(b.shape, 1);
    let out = allocTensorOn([m, n], a.device);
    dispatchSgemm(false, false, m, n, k, a, b, out);
    let aid = a.nodeId;
    let bid = b.nodeId;
    let ad = detach(a);
    let bd = detach(b);
    customVjp([aid, bid], out, (g: Tensor) -> {
        let ga = allocTensorOn([m, k], g.device);
        let gb = allocTensorOn([k, n], g.device);
        dispatchSgemm(false, true, m, k, n, g, bd, ga);
        dispatchSgemm(true, false, k, n, m, ad, g, gb);
        [(aid, ga), (bid, gb)]
    })
}

pub def matmulNT(x: Tensor, w: Tensor): Tensor = {
    let outDim = dimAt(w.shape, 0);
    let inDim = dimAt(w.shape, 1);
    let rows = x.numel / inDim;
    let outShape = replaceLastDim(x.shape, outDim);
    let out = allocTensorOn(outShape, x.device);
    dispatchSgemm(false, true, rows, outDim, inDim, x, w, out);
    let xid = x.nodeId;
    let wid = w.nodeId;
    let xd = detach(x);
    let wd = detach(w);
    customVjp([xid, wid], out, (g: Tensor) -> {
        let gx = allocTensorOn(xd.shape, g.device);
        let gw = allocTensorOn(wd.shape, g.device);
        dispatchSgemm(false, false, rows, inDim, outDim, g, wd, gx);
        dispatchSgemm(true, false, outDim, inDim, rows, g, xd, gw);
        [(xid, gx), (wid, gw)]
    })
}

pub def bgemm(a: Tensor, b: Tensor): Tensor = {
    let batch = dimAt(a.shape, 0);
    let m = dimAt(a.shape, 1);
    let k = dimAt(a.shape, 2);
    let n = dimAt(b.shape, 2);
    let out = allocTensorOn([batch, m, n], a.device);
    dispatchBgemm(batch, false, false, m, n, k, a, b, out);
    let aid = a.nodeId;
    let bid = b.nodeId;
    let ad = detach(a);
    let bd = detach(b);
    customVjp([aid, bid], out, (g: Tensor) -> {
        let ga = allocTensorOn([batch, m, k], g.device);
        let gb = allocTensorOn([batch, k, n], g.device);
        dispatchBgemm(batch, false, true, m, k, n, g, bd, ga);
        dispatchBgemm(batch, true, false, k, n, m, ad, g, gb);
        [(aid, ga), (bid, gb)]
    })
}

pub def bgemmNT(a: Tensor, b: Tensor): Tensor = {
    let batch = dimAt(a.shape, 0);
    let m = dimAt(a.shape, 1);
    let k = dimAt(a.shape, 2);
    let n = dimAt(b.shape, 1);
    let out = allocTensorOn([batch, m, n], a.device);
    dispatchBgemm(batch, false, true, m, n, k, a, b, out);
    let aid = a.nodeId;
    let bid = b.nodeId;
    let ad = detach(a);
    let bd = detach(b);
    customVjp([aid, bid], out, (g: Tensor) -> {
        let ga = allocTensorOn([batch, m, k], g.device);
        let gb = allocTensorOn([batch, n, k], g.device);
        dispatchBgemm(batch, false, false, m, k, n, g, bd, ga);
        dispatchBgemm(batch, true, false, n, k, m, g, ad, gb);
        [(aid, ga), (bid, gb)]
    })
}

// ============================================================================
// Shape, Transpose & General Axis Ops
// ============================================================================

pub def reshape(t: Tensor, newShape: List Int): Tensor = {
    let out = Tensor { buf: t.buf, gpuBuf: t.gpuBuf, shape: newShape, numel: t.numel, device: t.device, nodeId: -1, irId: -1 };
    let tid = t.nodeId;
    let origShape = t.shape;
    customVjp([tid], out, (g: Tensor) -> [(tid, Tensor { buf: g.buf, gpuBuf: g.gpuBuf, shape: origShape, numel: g.numel, device: g.device, nodeId: -1, irId: -1 })])
}

def insertAt(xs: List Int, idx: Int, val: Int): List Int =
    if (idx <= 0) Cons(val, xs)
    else match xs { Nil -> [val], Cons(h, r) -> Cons(h, insertAt(r, idx - 1, val)) }

def removeAt(xs: List Int, idx: Int): List Int = match xs {
    Nil -> Nil,
    Cons(h, r) -> if (idx == 0) r else Cons(h, removeAt(r, idx - 1)),
}

def setAt(xs: List Int, idx: Int, val: Int): List Int = match xs {
    Nil -> Nil,
    Cons(h, r) -> if (idx == 0) Cons(val, r) else Cons(h, setAt(r, idx - 1, val)),
}

pub def unsqueeze(t: Tensor, axis: Int): Tensor = {
    let ax = normalizeAxis(listLen(t.shape) + 1, axis);
    reshape(t, insertAt(t.shape, ax, 1))
}

pub def squeeze(t: Tensor, axis: Int): Tensor = {
    let ax = normalizeAxis(listLen(t.shape), axis);
    if (dimAt(t.shape, ax) == 1) reshape(t, removeAt(t.shape, ax)) else t
}

pub def transpose2d(t: Tensor): Tensor = {
    let r = dimAt(t.shape, 0);
    let c = dimAt(t.shape, 1);
    let out = allocTensorOn([c, r], t.device);
    if (isCuda(t.device)) cudaTranspose2d(devId(t.device), t.buf, out.buf, r, c)
    else { syncDevice(t.device); cpuTranspose2d(t.buf, out.buf, r, c) };
    let tid = t.nodeId;
    customVjp([tid], out, (g: Tensor) -> {
        let gx = allocTensorOn([r, c], g.device);
        if (isCuda(g.device)) cudaTranspose2d(devId(g.device), g.buf, gx.buf, c, r)
        else { syncDevice(g.device); cpuTranspose2d(g.buf, gx.buf, c, r) };
        [(tid, gx)]
    })
}

pub def transpose0213(t: Tensor): Tensor = {
    let d0 = dimAt(t.shape, 0);
    let d1 = dimAt(t.shape, 1);
    let d2 = dimAt(t.shape, 2);
    let d3 = dimAt(t.shape, 3);
    let out = allocTensorOn([d0, d2, d1, d3], t.device);
    if (isCuda(t.device)) cudaTranspose0213(devId(t.device), t.buf, out.buf, d0, d1, d2, d3)
    else { syncDevice(t.device); cpuTranspose0213(t.buf, out.buf, d0, d1, d2, d3) };
    let tid = t.nodeId;
    customVjp([tid], out, (g: Tensor) -> {
        let gx = allocTensorOn([d0, d1, d2, d3], g.device);
        if (isCuda(g.device)) cudaTranspose0213(devId(g.device), g.buf, gx.buf, d0, d2, d1, d3)
        else { syncDevice(g.device); cpuTranspose0213(g.buf, gx.buf, d0, d2, d1, d3) };
        [(tid, gx)]
    })
}

def axisOuterInner(sh: List Int, ax: Int): (Int, Int, Int) = {
    let outer = cellNew(1);
    let dim = cellNew(1);
    let inner = cellNew(1);
    let cur = cellNew(sh);
    let i = cellNew(0);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(d, r) -> {
                if (cellGet(i) < ax) cellSet(outer, cellGet(outer) * d)
                else if (cellGet(i) == ax) cellSet(dim, d)
                else cellSet(inner, cellGet(inner) * d);
                cellSet(i, cellGet(i) + 1);
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    (cellGet(outer), cellGet(dim), cellGet(inner))
}

pub def sliceAxis(x: Tensor, axis: Int, start: Int, len: Int): Tensor = {
    let ax = normalizeAxis(listLen(x.shape), axis);
    let (outer, inDim, inner) = axisOuterInner(x.shape, ax);
    let outSh = setAt(x.shape, ax, len);
    let out = allocTensorOn(outSh, x.device);
    if (isCuda(x.device)) cudaSliceAxisFwd(devId(x.device), x.buf, out.buf, outer, inDim, inner, start, len)
    else { syncDevice(x.device); cpuSliceAxisFwd(x.buf, out.buf, outer, inDim, inner, start, len) };
    let xid = x.nodeId;
    let xSh = x.shape;
    customVjp([xid], out, (g: Tensor) -> {
        let gx = allocTensorOn(xSh, g.device);
        if (isCuda(g.device)) cudaSliceAxisBwd(devId(g.device), g.buf, gx.buf, outer, inDim, inner, start, len)
        else { syncDevice(g.device); cpuSliceAxisBwd(g.buf, gx.buf, outer, inDim, inner, start, len) };
        [(xid, gx)]
    })
}

pub def chunkAxis(x: Tensor, axis: Int, nChunks: Int): List Tensor = {
    let ax = normalizeAxis(listLen(x.shape), axis);
    let dim = dimAt(x.shape, ax);
    let step = dim / nChunks;
    let acc = cellNew(Nil);
    let i = cellNew(0);
    while (cellGet(i) < nChunks) {
        let part = sliceAxis(x, ax, cellGet(i) * step, step);
        cellSet(acc, Cons(part, cellGet(acc)));
        cellSet(i, cellGet(i) + 1)
    };
    listRev(cellGet(acc))
}

pub def catAxis(xs: List Tensor, axis: Int): Tensor = match xs {
    Nil -> zerosOn([0], Cpu),
    Cons(first, Nil) -> first,
    Cons(first, _) -> {
        let ax = normalizeAxis(listLen(first.shape), axis);
        let totalDim = cellNew(0);
        let idsRev = cellNew(Nil);
        let cur = cellNew(xs);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(t, r) -> {
                    cellSet(totalDim, cellGet(totalDim) + dimAt(t.shape, ax));
                    cellSet(idsRev, Cons(t.nodeId, cellGet(idsRev)));
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        let outDim = cellGet(totalDim);
        let outSh = setAt(first.shape, ax, outDim);
        let (outer, _, inner) = axisOuterInner(outSh, ax);
        let out = allocTensorOn(outSh, first.device);
        let off = cellNew(0);
        let cur2 = cellNew(xs);
        while (match cellGet(cur2) { Nil -> false, _ -> true }) {
            match cellGet(cur2) {
                Cons(t, r) -> {
                    let len = dimAt(t.shape, ax);
                    let tmp = allocTensorOn(outSh, first.device);
                    if (isCuda(first.device)) cudaSliceAxisBwd(devId(first.device), t.buf, tmp.buf, outer, outDim, inner, cellGet(off), len)
                    else { syncDevice(t.device); cpuSliceAxisBwd(t.buf, tmp.buf, outer, outDim, inner, cellGet(off), len) };
                    axpyInPlace(1.0, tmp, out);
                    cellSet(off, cellGet(off) + len);
                    cellSet(cur2, r)
                },
                Nil -> (),
            }
        };
        let specsRev = cellNew(Nil);
        let off2 = cellNew(0);
        let cur3 = cellNew(xs);
        while (match cellGet(cur3) { Nil -> false, _ -> true }) {
            match cellGet(cur3) {
                Cons(t, r) -> {
                    let len = dimAt(t.shape, ax);
                    cellSet(specsRev, Cons((t.nodeId, cellGet(off2), len, t.shape), cellGet(specsRev)));
                    cellSet(off2, cellGet(off2) + len);
                    cellSet(cur3, r)
                },
                Nil -> (),
            }
        };
        let specs = listRev(cellGet(specsRev));
        customVjp(listRev(cellGet(idsRev)), out, (g: Tensor) -> {
            let resRev = cellNew(Nil);
            let cs = cellNew(specs);
            while (match cellGet(cs) { Nil -> false, _ -> true }) {
                match cellGet(cs) {
                    Cons((tid, st, ln, tSh), rs) -> {
                        let gt = allocTensorOn(tSh, g.device);
                        if (isCuda(g.device)) cudaSliceAxisFwd(devId(g.device), g.buf, gt.buf, outer, outDim, inner, st, ln)
                        else { syncDevice(g.device); cpuSliceAxisFwd(g.buf, gt.buf, outer, outDim, inner, st, ln) };
                        cellSet(resRev, Cons((tid, gt), cellGet(resRev)));
                        cellSet(cs, rs)
                    },
                    Nil -> (),
                }
            };
            listRev(cellGet(resRev))
        })
    },
}

pub def padAxis(x: Tensor, axis: Int, padLeft: Int, padRight: Int, val: Float): Tensor = {
    let ax = normalizeAxis(listLen(x.shape), axis);
    let parts = cellNew([x]);
    if (padRight > 0) {
        let rSh = setAt(x.shape, ax, padRight);
        cellSet(parts, [x, fullOn(rSh, val, x.device)])
    } else ();
    if (padLeft > 0) {
        let lSh = setAt(x.shape, ax, padLeft);
        cellSet(parts, Cons(fullOn(lSh, val, x.device), cellGet(parts)))
    } else ();
    catAxis(cellGet(parts), ax)
}

// ============================================================================
// Reductions, Norms, Softmax, Losses, Embedding, RoPE & Causal Mask
// ============================================================================

pub def sumAll(x: Tensor): Tensor = {
    let v = if (isCuda(x.device)) cudaSumAll(devId(x.device), x.buf, x.numel)
            else { syncDevice(x.device); cpuSumAll(x.buf, x.numel) };
    let out = fullOn([1], v, x.device);
    let xid = x.nodeId;
    let xShape = x.shape;
    let xDev = x.device;
    customVjp([xid], out, (g: Tensor) -> [(xid, fullOn(xShape, item(g), xDev))])
}

pub def meanAll(x: Tensor): Tensor = scale(sumAll(x), 1.0 / intToFloat(x.numel))

pub def sumAxis(x: Tensor, axis: Int, keepDim: Bool): Tensor = {
    let ax = normalizeAxis(listLen(x.shape), axis);
    let (outer, dim, inner) = axisOuterInner(x.shape, ax);
    let keepSh = setAt(x.shape, ax, 1);
    let outSh = if (keepDim) keepSh else removeAt(x.shape, ax);
    let out = allocTensorOn(outSh, x.device);
    if (isCuda(x.device)) cudaSumAxis(devId(x.device), x.buf, out.buf, outer, dim, inner)
    else { syncDevice(x.device); cpuSumAxis(x.buf, out.buf, outer, dim, inner) };
    let xid = x.nodeId;
    let xSh = x.shape;
    customVjp([xid], out, (g: Tensor) -> {
        let gKeep = Tensor { buf: g.buf, gpuBuf: g.gpuBuf, shape: keepSh, numel: g.numel, device: g.device, nodeId: -1, irId: -1 };
        let z = zerosOn(xSh, g.device);
        [(xid, rawBinop(0, z, gKeep))]
    })
}

pub def meanAxis(x: Tensor, axis: Int, keepDim: Bool): Tensor = {
    let ax = normalizeAxis(listLen(x.shape), axis);
    let d = dimAt(x.shape, ax);
    scale(sumAxis(x, ax, keepDim), 1.0 / intToFloat(d))
}

pub def maxAxis(x: Tensor, axis: Int, keepDim: Bool): Tensor = {
    let ax = normalizeAxis(listLen(x.shape), axis);
    let (outer, dim, inner) = axisOuterInner(x.shape, ax);
    let outSh = if (keepDim) setAt(x.shape, ax, 1) else removeAt(x.shape, ax);
    let out = allocTensorOn(outSh, x.device);
    if (isCuda(x.device)) cudaMaxAxis(devId(x.device), x.buf, out.buf, outer, dim, inner)
    else { syncDevice(x.device); cpuMaxAxis(x.buf, out.buf, outer, dim, inner) };
    out
}

pub def logSumExpLast(x: Tensor): Tensor = {
    let rank = listLen(x.shape);
    let cols = dimAt(x.shape, rank - 1);
    let rows = x.numel / cols;
    let outSh = removeAt(x.shape, rank - 1);
    let out = allocTensorOn(if (listLen(outSh) == 0) [1] else outSh, x.device);
    if (isCuda(x.device)) cudaLogSumExpFwd(devId(x.device), x.buf, out.buf, rows, cols)
    else { syncDevice(x.device); cpuLogSumExpFwd(x.buf, out.buf, rows, cols) };
    let xid = x.nodeId;
    let xd = detach(x);
    let lseD = detach(out);
    customVjp([xid], out, (g: Tensor) -> {
        let gx = allocTensorOn(xd.shape, g.device);
        if (isCuda(g.device)) cudaLogSumExpBwd(devId(g.device), xd.buf, lseD.buf, g.buf, gx.buf, rows, cols)
        else { syncDevice(g.device); cpuLogSumExpBwd(xd.buf, lseD.buf, g.buf, gx.buf, rows, cols) };
        [(xid, gx)]
    })
}

pub def sumSqFloat(x: Tensor): Float =
    if (isCuda(x.device)) cudaSumSq(devId(x.device), x.buf, x.numel)
    else { syncDevice(x.device); cpuSumSq(x.buf, x.numel) }

pub def l2NormFloat(x: Tensor): Float =
    f32ToFloat(mathSqrtF32(floatToF32(sumSqFloat(x))))

pub def rmsNorm(x: Tensor, w: Tensor, eps: Float): Tensor = {
    let dim = w.numel;
    let rows = x.numel / dim;
    let out = allocTensorOn(x.shape, x.device);
    if (isCuda(x.device)) cudaRmsNormFwd(devId(x.device), x.buf, w.buf, out.buf, rows, dim, eps)
    else { syncDevice(x.device); cpuRmsNormFwd(x.buf, w.buf, out.buf, rows, dim, eps) };
    let xid = x.nodeId;
    let wid = w.nodeId;
    let xd = detach(x);
    let wd = detach(w);
    customVjp([xid, wid], out, (g: Tensor) -> {
        let gx = allocTensorOn(xd.shape, g.device);
        let gw = allocTensorOn(wd.shape, g.device);
        if (isCuda(g.device)) cudaRmsNormBwd(devId(g.device), xd.buf, wd.buf, g.buf, gx.buf, gw.buf, rows, dim, eps)
        else { syncDevice(g.device); cpuRmsNormBwd(xd.buf, wd.buf, g.buf, gx.buf, gw.buf, rows, dim, eps) };
        [(xid, gx), (wid, gw)]
    })
}

pub def layerNorm(x: Tensor, w: Tensor, b: Tensor, eps: Float): Tensor = {
    let dim = w.numel;
    let rows = x.numel / dim;
    let out = allocTensorOn(x.shape, x.device);
    if (isCuda(x.device)) cudaLayerNormFwd(devId(x.device), x.buf, w.buf, b.buf, out.buf, rows, dim, eps)
    else { syncDevice(x.device); cpuLayerNormFwd(x.buf, w.buf, b.buf, out.buf, rows, dim, eps) };
    let xid = x.nodeId;
    let wid = w.nodeId;
    let bid = b.nodeId;
    let xd = detach(x);
    let wd = detach(w);
    let bSh = b.shape;
    customVjp([xid, wid, bid], out, (g: Tensor) -> {
        let gx = allocTensorOn(xd.shape, g.device);
        let gw = allocTensorOn(wd.shape, g.device);
        let gb = allocTensorOn(bSh, g.device);
        if (isCuda(g.device)) cudaLayerNormBwd(devId(g.device), xd.buf, wd.buf, g.buf, gx.buf, gw.buf, gb.buf, rows, dim, eps)
        else { syncDevice(g.device); cpuLayerNormBwd(xd.buf, wd.buf, g.buf, gx.buf, gw.buf, gb.buf, rows, dim, eps) };
        [(xid, gx), (wid, gw), (bid, gb)]
    })
}

pub def l2NormLast(x: Tensor, eps: Float): Tensor = {
    let cols = dimAt(x.shape, listLen(x.shape) - 1);
    let rows = x.numel / cols;
    let out = allocTensorOn(x.shape, x.device);
    if (isCuda(x.device)) cudaL2NormLastFwd(devId(x.device), x.buf, out.buf, rows, cols, eps)
    else { syncDevice(x.device); cpuL2NormLastFwd(x.buf, out.buf, rows, cols, eps) };
    let xid = x.nodeId;
    let xd = detach(x);
    customVjp([xid], out, (g: Tensor) -> {
        let gx = allocTensorOn(xd.shape, g.device);
        if (isCuda(g.device)) cudaL2NormLastBwd(devId(g.device), xd.buf, g.buf, gx.buf, rows, cols, eps)
        else { syncDevice(g.device); cpuL2NormLastBwd(xd.buf, g.buf, gx.buf, rows, cols, eps) };
        [(xid, gx)]
    })
}

pub def softmax(x: Tensor): Tensor = {
    let cols = dimAt(x.shape, listLen(x.shape) - 1);
    let rows = x.numel / cols;
    let out = allocTensorOn(x.shape, x.device);
    if (isCuda(x.device)) cudaSoftmaxFwd(devId(x.device), x.buf, out.buf, rows, cols)
    else { syncDevice(x.device); cpuSoftmaxFwd(x.buf, out.buf, rows, cols) };
    let xid = x.nodeId;
    let yd = detach(out);
    customVjp([xid], out, (g: Tensor) -> {
        let gx = allocTensorOn(yd.shape, g.device);
        if (isCuda(g.device)) cudaSoftmaxBwd(devId(g.device), yd.buf, g.buf, gx.buf, rows, cols)
        else { syncDevice(g.device); cpuSoftmaxBwd(yd.buf, g.buf, gx.buf, rows, cols) };
        [(xid, gx)]
    })
}

pub def logSoftmax(x: Tensor): Tensor = sub(x, unsqueeze(logSumExpLast(x), -1))

pub def crossEntropyIgnore(logits: Tensor, targets: IntTensor, ignoreIndex: Int): Tensor = {
    let vocab = dimAt(logits.shape, listLen(logits.shape) - 1);
    let rows = logits.numel / vocab;
    let probs = allocTensorOn(logits.shape, logits.device);
    let lossVal = if (isCuda(logits.device)) cudaCrossEntropyFwd(devId(logits.device), logits.buf, targets.buf, probs.buf, rows, vocab, ignoreIndex)
                  else { syncDevice(logits.device); cpuCrossEntropyFwd(logits.buf, targets.buf, probs.buf, rows, vocab, ignoreIndex) };
    let out = fullOn([1], lossVal, logits.device);
    let lid = logits.nodeId;
    let lShape = logits.shape;
    customVjp([lid], out, (g: Tensor) -> {
        let gl = allocTensorOn(lShape, logits.device);
        if (isCuda(logits.device)) cudaCrossEntropyBwd(devId(logits.device), probs.buf, targets.buf, item(g), gl.buf, rows, vocab, ignoreIndex)
        else { syncDevice(logits.device); cpuCrossEntropyBwd(probs.buf, targets.buf, item(g), gl.buf, rows, vocab, ignoreIndex) };
        [(lid, gl)]
    })
}

pub def crossEntropy(logits: Tensor, targets: IntTensor): Tensor =
    crossEntropyIgnore(logits, targets, -100)

pub def mseLoss(pred: Tensor, target: Tensor): Tensor =
    meanAll(square(sub(pred, target)))

pub def embedding(table: Tensor, ids: IntTensor): Tensor = {
    let vocab = dimAt(table.shape, 0);
    let dim = dimAt(table.shape, 1);
    let nIds = ids.numel;
    let outShape = listRev(Cons(dim, listRev(ids.shape)));
    let out = allocTensorOn(outShape, table.device);
    if (isCuda(table.device)) cudaEmbeddingFwd(devId(table.device), table.buf, ids.buf, out.buf, nIds, dim)
    else { syncDevice(table.device); cpuEmbeddingFwd(table.buf, ids.buf, out.buf, nIds, dim) };
    let tid = table.nodeId;
    customVjp([tid], out, (g: Tensor) -> {
        let gt = allocTensorOn([vocab, dim], table.device);
        if (isCuda(table.device)) cudaEmbeddingBwd(devId(table.device), ids.buf, g.buf, gt.buf, nIds, vocab, dim)
        else { syncDevice(g.device); cpuEmbeddingBwd(ids.buf, g.buf, gt.buf, nIds, vocab, dim) };
        [(tid, gt)]
    })
}

pub def rope(x: Tensor, theta: Float): Tensor = {
    let b = dimAt(x.shape, 0);
    let s = dimAt(x.shape, 1);
    let h = dimAt(x.shape, 2);
    let hd = dimAt(x.shape, 3);
    let out = allocTensorOn(x.shape, x.device);
    if (isCuda(x.device)) cudaRope(devId(x.device), x.buf, out.buf, b, s, h, hd, theta, false)
    else { syncDevice(x.device); cpuRope(x.buf, out.buf, b, s, h, hd, theta, false) };
    let xid = x.nodeId;
    customVjp([xid], out, (g: Tensor) -> {
        let gx = allocTensorOn([b, s, h, hd], g.device);
        if (isCuda(g.device)) cudaRope(devId(g.device), g.buf, gx.buf, b, s, h, hd, theta, true)
        else { syncDevice(g.device); cpuRope(g.buf, gx.buf, b, s, h, hd, theta, true) };
        [(xid, gx)]
    })
}

pub def causalMask(scores: Tensor): Tensor = {
    let bh = dimAt(scores.shape, 0);
    let seq = dimAt(scores.shape, 1);
    let out = cloneTensor(scores);
    if (isCuda(scores.device)) cudaCausalMaskAdd(devId(scores.device), out.buf, bh, seq)
    else { syncDevice(scores.device); cpuCausalMaskAdd(out.buf, bh, seq) };
    let sid = scores.nodeId;
    customVjp([sid], out, (g: Tensor) -> [(sid, g)])
}
