extern noalloc "gs_t_rms_norm_bwd" def c_rms_norm_bwd(dk: Int, did: Int, x: ScopedPtr, w: ScopedPtr, gy: ScopedPtr, gx: ScopedPtr, gw: ScopedPtr, rows: Int, dim: Int, eps: Float32): Void
