// Core `Tensor` / `IntTensor` data structures, shape & broadcast utilities,
// allocation/transfer, and the local-tape reverse-mode autodiff engine (`customVjp`).

use std.option.{Option, Some, None}
use std.list.{listLen, listNth, listRev}
use std.vec.{Vec, vecNew, vecLen, vecPush, vecGet, vecSet}
use tensor.backend.{Device, Cpu, Cuda, Metal, devKind, devId, cudaAvailable, autoDevice}
use tensor.cpu.{cpuFill, cpuCopy, cpuRandn, cpuAxpy, cpuBinopSame, cpuAdamwStep}
use tensor.metal.{metalAllocShared, metalSync, metalScaleOrAxpy, metalBinopSame}
use tensor.cuda.{
    cudaAllocBuf, cudaZero, cudaSync, cudaH2d, cudaD2h, cudaD2d,
    cudaFill, cudaCopy, cudaRandn, cudaAxpy, cudaBinopSame, cudaAdamwStep
}

// ============================================================================
// Tensor & IntTensor Types
// ============================================================================

pub data Tensor {
    buf: ForeignPtr,
    gpuBuf: Option ForeignPtr,
    shape: List Int,
    numel: Int,
    device: Device,
    nodeId: Int,
    irId: Int,
}

// ============================================================================
// Lightweight Elementwise JIT Trace IR (Shape-Agnostic + Scalar-Lifted)
// ============================================================================

pub data IrOp {
    IrInput(Int),
    IrBin(Int, Int, Int),         // op (0=add,1=sub,2=mul,3=div), lhs, rhs
    IrUnary(Int, Int),            // op (0..11), x
    IrScale(Int, Int),            // x, scalarIdx
    IrAddScalar(Int, Int),        // x, scalarIdx
    IrPowScalar(Int, Int),        // x, scalarIdx
    IrClamp(Int, Int, Int),       // x, loScalarIdx, hiScalarIdx
    IrLeakyRelu(Int, Int),        // x, slopeScalarIdx
}

pub data JitTrace {
    nodes: Vec IrOp,
    scalars: Vec Float32,
    inputs: Vec Tensor,
}

def activeJitCell: Cell (Option JitTrace) = cellNew(None)

pub def beginJitTrace(): JitTrace = {
    let tr = JitTrace { nodes: vecNew(), scalars: vecNew(), inputs: vecNew() };
    cellSet(activeJitCell, Some(tr));
    tr
}

pub def endJitTrace(): Void = cellSet(activeJitCell, None)

pub def getActiveJitTrace(): Option JitTrace = cellGet(activeJitCell)

pub def jitPushScalar(tr: JitTrace, v: Float): Int = {
    let idx = vecLen(tr.scalars);
    vecPush(tr.scalars, floatToF32(v));
    idx
}

pub def jitRecordNode(tr: JitTrace, op: IrOp, sh: List Int, dev: Device): Tensor = {
    let id = vecLen(tr.nodes);
    vecPush(tr.nodes, op);
    Tensor {
        buf: foreignPtrNew(ptrNull(), ptrNull(), intToI64(0)),
        gpuBuf: None,
        shape: sh,
        numel: shapeProd(sh),
        device: dev,
        nodeId: -1,
        irId: id,
    }
}

pub def jitStampInput(tr: JitTrace, t: Tensor): Tensor = {
    let slot = vecLen(tr.inputs);
    vecPush(tr.inputs, t);
    let id = vecLen(tr.nodes);
    vecPush(tr.nodes, IrInput(slot));
    Tensor {
        buf: t.buf,
        gpuBuf: t.gpuBuf,
        shape: t.shape,
        numel: t.numel,
        device: t.device,
        nodeId: -1,
        irId: id,
    }
}

pub data IntTensor {
    buf: ForeignPtr,
    shape: List Int,
    numel: Int,
    device: Device,
}

// ============================================================================
// Shape & Broadcast Utilities
// ============================================================================

pub def shapeProd(sh: List Int): Int = match sh {
    Nil -> 1,
    Cons(d, r) -> d * shapeProd(r),
}

pub def shapeEq(a: List Int, b: List Int): Bool = match (a, b) {
    (Nil, Nil) -> true,
    (Cons(x, rx), Cons(y, ry)) -> x == y && shapeEq(rx, ry),
    _ -> false,
}

pub def dimAt(sh: List Int, idx: Int): Int = match listNth(sh, idx) {
    Some(d) -> d,
    None -> 1,
}

pub def normalizeAxis(rank: Int, axis: Int): Int =
    if (axis < 0) rank + axis else axis

def padLeftOnes(sh: List Int, targetLen: Int): List Int = {
    let cur = cellNew(sh);
    let len = cellNew(listLen(sh));
    while (cellGet(len) < targetLen) {
        cellSet(cur, Cons(1, cellGet(cur)));
        cellSet(len, cellGet(len) + 1)
    };
    cellGet(cur)
}

pub def broadcastShape(a: List Int, b: List Int): List Int = {
    let la = listLen(a);
    let lb = listLen(b);
    let nd = if (la > lb) la else lb;
    let pa = padLeftOnes(a, nd);
    let pb = padLeftOnes(b, nd);
    let ca = cellNew(pa);
    let cb = cellNew(pb);
    let acc = cellNew(Nil);
    while (match (cellGet(ca), cellGet(cb)) { (Cons(_, _), Cons(_, _)) -> true, _ -> false }) {
        match (cellGet(ca), cellGet(cb)) {
            (Cons(da, ra), Cons(db, rb)) -> {
                let d = if (da > db) da else db;
                cellSet(acc, Cons(d, cellGet(acc)));
                cellSet(ca, ra);
                cellSet(cb, rb)
            },
            _ -> (),
        }
    };
    listRev(cellGet(acc))
}

pub def broadcastStrides(inShape: List Int, outShape: List Int): List Int = {
    let nd = listLen(outShape);
    let padded = padLeftOnes(inShape, nd);
    let revIn = listRev(padded);
    let revOut = listRev(outShape);
    let ci = cellNew(revIn);
    let co = cellNew(revOut);
    let stride = cellNew(1);
    let res = cellNew(Nil);
    while (match (cellGet(ci), cellGet(co)) { (Cons(_, _), Cons(_, _)) -> true, _ -> false }) {
        match (cellGet(ci), cellGet(co)) {
            (Cons(di, ri), Cons(dout, ro)) -> {
                let s = if (di == 1 && dout > 1) 0 else cellGet(stride);
                cellSet(res, Cons(s, cellGet(res)));
                cellSet(stride, cellGet(stride) * di);
                cellSet(ci, ri);
                cellSet(co, ro)
            },
            _ -> (),
        }
    };
    cellGet(res)
}

pub def packI32List(xs: List Int): ForeignPtr = {
    let n = listLen(xs);
    let nb = intToI64(if (n > 0) n * 4 else 4);
    let fp = allocBuf(Cpu, nb);
    withForeignPtr(fp, (sp) -> {
        let cur = cellNew(xs);
        let i = cellNew(0);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(v, r) -> {
                    scopedPtrWriteI32Le(sp, cellGet(i) * 4, v);
                    cellSet(i, cellGet(i) + 1);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    });
    fp
}

// ============================================================================
// Allocation, Creation & Device Transfer
// ============================================================================

pub def allocBuf(_dev: Device, nbytes: Int64): ForeignPtr =
    foreignPtrAlloc(if (nbytes > intToI64(0)) nbytes else intToI64(4))

pub def isMetal(d: Device): Bool = match d {
    Metal(_) -> true,
    _ -> false,
}

pub def isCuda(d: Device): Bool = match d {
    Cuda(_) -> true,
    _ -> false,
}

pub def syncDevice(d: Device): Void = match d {
    Metal(_) -> metalSync(),
    Cuda(id) -> cudaSync(id),
    _ -> (),
}

pub def allocTensorOn(sh: List Int, dev: Device): Tensor = {
    let n = shapeProd(sh);
    let nb = intToI64(n) * intToI64(4);
    match dev {
        Metal(_) -> {
            let (cpuView, gpuOwner) = metalAllocShared(nb);
            Tensor { buf: cpuView, gpuBuf: gpuOwner, shape: sh, numel: n, device: dev, nodeId: -1, irId: -1 }
        },
        Cuda(id) -> {
            let cbuf = cudaAllocBuf(id, nb);
            Tensor { buf: cbuf, gpuBuf: None, shape: sh, numel: n, device: dev, nodeId: -1, irId: -1 }
        },
        _ -> Tensor { buf: allocBuf(dev, nb), gpuBuf: None, shape: sh, numel: n, device: dev, nodeId: -1, irId: -1 },
    }
}

pub def zerosOn(sh: List Int, dev: Device): Tensor = {
    let t = allocTensorOn(sh, dev);
    match dev {
        Cuda(id) -> cudaZero(id, t.buf, intToI64(t.numel) * intToI64(4)),
        _ -> (),
    };
    t
}
pub def zeros(sh: List Int): Tensor = zerosOn(sh, Cpu)

pub def fullOn(sh: List Int, val: Float, dev: Device): Tensor = {
    let t = allocTensorOn(sh, dev);
    match dev {
        Cuda(id) -> cudaFill(id, t.buf, t.numel, floatToF32(val)),
        _ -> cpuFill(t.buf, t.numel, floatToF32(val)),
    };
    t
}

pub def full(sh: List Int, val: Float): Tensor = fullOn(sh, val, Cpu)
pub def onesOn(sh: List Int, dev: Device): Tensor = fullOn(sh, 1.0, dev)
pub def ones(sh: List Int): Tensor = onesOn(sh, Cpu)
pub def zerosLike(t: Tensor): Tensor = zerosOn(t.shape, t.device)
pub def onesLike(t: Tensor): Tensor = onesOn(t.shape, t.device)

pub def randnOn(sh: List Int, seed: Int64, std: Float, dev: Device): Tensor = {
    let t = allocTensorOn(sh, dev);
    match dev {
        Cuda(id) -> cudaRandn(id, t.buf, t.numel, seed, std),
        _ -> cpuRandn(t.buf, t.numel, seed, std),
    };
    t
}

pub def randn(sh: List Int, seed: Int64, std: Float): Tensor = randnOn(sh, seed, std, Cpu)

pub def arange(n: Int): Tensor = {
    let t = zerosOn([n], Cpu);
    withForeignPtr(t.buf, (sp) -> {
        let i = cellNew(0);
        while (cellGet(i) < n) {
            scopedPtrWriteF32Le(sp, cellGet(i) * 4, intToF32(cellGet(i)));
            cellSet(i, cellGet(i) + 1)
        }
    });
    t
}

pub def fromList(sh: List Int, xs: List Float): Tensor = {
    let t = zerosOn(sh, Cpu);
    withForeignPtr(t.buf, (sp) -> {
        let cur = cellNew(xs);
        let i = cellNew(0);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(v, r) -> {
                    scopedPtrWriteF32Le(sp, cellGet(i) * 4, floatToF32(v));
                    cellSet(i, cellGet(i) + 1);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    });
    t
}

pub def fromI32ListOn(sh: List Int, xs: List Int, dev: Device): IntTensor = {
    let n = shapeProd(sh);
    let nb = intToI64(n) * intToI64(4);
    let hostBuf = allocBuf(Cpu, nb);
    withForeignPtr(hostBuf, (sp) -> {
        let cur = cellNew(xs);
        let i = cellNew(0);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(v, r) -> {
                    scopedPtrWriteI32Le(sp, cellGet(i) * 4, v);
                    cellSet(i, cellGet(i) + 1);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    });
    match dev {
        Cuda(id) -> {
            let devBuf = cudaAllocBuf(id, nb);
            cudaH2d(id, devBuf, hostBuf, nb);
            IntTensor { buf: devBuf, shape: sh, numel: n, device: dev }
        },
        _ -> IntTensor { buf: hostBuf, shape: sh, numel: n, device: dev },
    }
}

pub def fromI32List(sh: List Int, xs: List Int): IntTensor = fromI32ListOn(sh, xs, Cpu)

pub def tensorFromHostBufOn(sh: List Int, hostBuf: ForeignPtr, dev: Device): Tensor = {
    let n = shapeProd(sh);
    let nb = intToI64(n) * intToI64(4);
    match dev {
        Cuda(id) -> {
            let devBuf = cudaAllocBuf(id, nb);
            cudaH2d(id, devBuf, hostBuf, nb);
            Tensor { buf: devBuf, gpuBuf: None, shape: sh, numel: n, device: dev, nodeId: -1, irId: -1 }
        },
        Metal(_) -> {
            let out = allocTensorOn(sh, dev);
            cpuCopy(out.buf, hostBuf, n);
            out
        },
        _ -> Tensor { buf: hostBuf, gpuBuf: None, shape: sh, numel: n, device: dev, nodeId: -1, irId: -1 },
    }
}

pub def intTensorFromHostBufOn(sh: List Int, hostBuf: ForeignPtr, dev: Device): IntTensor = {
    let n = shapeProd(sh);
    let nb = intToI64(n) * intToI64(4);
    match dev {
        Cuda(id) -> {
            let devBuf = cudaAllocBuf(id, nb);
            cudaH2d(id, devBuf, hostBuf, nb);
            IntTensor { buf: devBuf, shape: sh, numel: n, device: dev }
        },
        _ -> IntTensor { buf: hostBuf, shape: sh, numel: n, device: dev },
    }
}

pub def tensorDevice(t: Tensor): Device = t.device

pub def toDevice(t: Tensor, dev: Device): Tensor =
    if (t.device == dev) t
    else {
        let nb = intToI64(t.numel) * intToI64(4);
        match (t.device, dev) {
            (Cuda(id1), Cuda(id2)) -> {
                let out = allocTensorOn(t.shape, dev);
                if (id1 == id2) cudaD2d(id1, out.buf, t.buf, nb)
                else {
                    let tmp = allocBuf(Cpu, nb);
                    cudaD2h(id1, tmp, t.buf, nb);
                    cudaH2d(id2, out.buf, tmp, nb)
                };
                out
            },
            (Cuda(id), _) -> {
                let out = allocTensorOn(t.shape, dev);
                cudaD2h(id, out.buf, t.buf, nb);
                out
            },
            (_, Cuda(id)) -> {
                syncDevice(t.device);
                let out = allocTensorOn(t.shape, dev);
                cudaH2d(id, out.buf, t.buf, nb);
                out
            },
            _ -> {
                syncDevice(t.device);
                let out = allocTensorOn(t.shape, dev);
                cpuCopy(out.buf, t.buf, t.numel);
                out
            },
        }
    }

pub def detach(t: Tensor): Tensor =
    Tensor { buf: t.buf, gpuBuf: t.gpuBuf, shape: t.shape, numel: t.numel, device: t.device, nodeId: -1, irId: -1 }

pub def getAt(t: Tensor, idx: Int): Float = match t.device {
    Cuda(_) -> {
        let host = toDevice(t, Cpu);
        withForeignPtr(host.buf, (sp) -> f32ToFloat(scopedPtrReadF32Le(sp, idx * 4)))
    },
    _ -> {
        syncDevice(t.device);
        withForeignPtr(t.buf, (sp) -> f32ToFloat(scopedPtrReadF32Le(sp, idx * 4)))
    },
}

pub def item(t: Tensor): Float = getAt(t, 0)

pub def toList(t: Tensor): List Float = match t.device {
    Cuda(_) -> toList(toDevice(t, Cpu)),
    _ -> {
        syncDevice(t.device);
        withForeignPtr(t.buf, (sp) -> {
            let acc = cellNew(Nil);
            let i = cellNew(t.numel - 1);
            while (cellGet(i) >= 0) {
                let v = f32ToFloat(scopedPtrReadF32Le(sp, cellGet(i) * 4));
                cellSet(acc, Cons(v, cellGet(acc)));
                cellSet(i, cellGet(i) - 1)
            };
            cellGet(acc)
        })
    },
}

pub def axpyInPlace(alpha: Float, x: Tensor, y: Tensor): Void = match y.device {
    Cuda(id) -> cudaAxpy(id, floatToF32(alpha), x.buf, y.buf, y.numel),
    Metal(_) -> metalScaleOrAxpy("k_axpy", x.gpuBuf, y.gpuBuf, floatToF32(alpha), y.numel),
    _ -> cpuAxpy(floatToF32(alpha), x.buf, y.buf, y.numel),
}

pub def cloneTensor(t: Tensor): Tensor = match t.device {
    Cuda(id) -> {
        let out = allocTensorOn(t.shape, t.device);
        cudaCopy(id, out.buf, t.buf, t.numel);
        out
    },
    _ -> {
        syncDevice(t.device);
        let out = allocTensorOn(t.shape, t.device);
        cpuCopy(out.buf, t.buf, t.numel);
        out
    },
}

pub def adamwStepRaw(
    p: Tensor, g: Tensor, m: Tensor, v: Tensor,
    lr: Float, beta1: Float, beta2: Float, eps: Float, wd: Float, bc1: Float, bc2: Float
): (Tensor, Tensor, Tensor) = {
    let pOut = allocTensorOn(p.shape, p.device);
    let mOut = allocTensorOn(m.shape, m.device);
    let vOut = allocTensorOn(v.shape, v.device);
    match p.device {
        Cuda(id) -> cudaAdamwStep(
            id, p.buf, g.buf, m.buf, v.buf,
            pOut.buf, mOut.buf, vOut.buf, p.numel,
            floatToF32(lr), floatToF32(beta1), floatToF32(beta2),
            floatToF32(eps), floatToF32(wd), floatToF32(bc1), floatToF32(bc2)
        ),
        _ -> cpuAdamwStep(
            p.buf, g.buf, m.buf, v.buf,
            pOut.buf, mOut.buf, vOut.buf,
            p.numel,
            floatToF32(lr), floatToF32(beta1), floatToF32(beta2),
            floatToF32(eps), floatToF32(wd), floatToF32(bc1), floatToF32(bc2)
        ),
    };
    (pOut, mOut, vOut)
}

// ============================================================================
// Local-Tape Reverse-Mode Autodiff Engine (`customVjp`)
// ============================================================================

pub data TapeNode {
    bwd: Tensor -> List (Int, Tensor),
}

pub data Tape {
    nodes: Vec TapeNode,
}

def activeTapeCell: Cell (Option Tape) = cellNew(None)

pub def beginTape(): Tape = {
    let tp = Tape { nodes: vecNew() };
    cellSet(activeTapeCell, Some(tp));
    tp
}

pub def endTape(): Void = cellSet(activeTapeCell, None)

pub def getActiveTape(): Option Tape = cellGet(activeTapeCell)
pub def setActiveTape(t: Option Tape): Void = cellSet(activeTapeCell, t)

pub def stampLeaf(tp: Tape, t: Tensor): Tensor = {
    let id = vecLen(tp.nodes);
    vecPush(tp.nodes, TapeNode { bwd: (_) -> Nil });
    Tensor { buf: t.buf, gpuBuf: t.gpuBuf, shape: t.shape, numel: t.numel, device: t.device, nodeId: id, irId: -1 }
}

def anyTracked(ids: List Int): Bool = match ids {
    Nil -> false,
    Cons(i, r) -> if (i >= 0) true else anyTracked(r),
}

pub def customVjp(inputIds: List Int, out: Tensor, bwdFn: Tensor -> List (Int, Tensor)): Tensor =
    if (!anyTracked(inputIds)) out
    else match cellGet(activeTapeCell) {
        None -> out,
        Some(tp) -> {
            let id = vecLen(tp.nodes);
            vecPush(tp.nodes, TapeNode { bwd: bwdFn });
            Tensor { buf: out.buf, gpuBuf: out.gpuBuf, shape: out.shape, numel: out.numel, device: out.device, nodeId: id, irId: -1 }
        },
    }

def addSameRaw(a: Tensor, b: Tensor): Tensor = {
    let out = allocTensorOn(a.shape, a.device);
    match a.device {
        Cuda(id) -> cudaBinopSame(id, 0, a.buf, b.buf, out.buf, a.numel),
        Metal(_) -> metalBinopSame(0, a.gpuBuf, b.gpuBuf, out.gpuBuf, a.numel),
        _ -> cpuBinopSame(0, a.buf, b.buf, out.buf, a.numel),
    };
    out
}

pub def runBackwardWithSeed(tp: Tape, loss: Tensor, seedGrad: Tensor): Vec (Option Tensor) = {
    let n = vecLen(tp.nodes);
    let grads = vecNew();
    let owned = arrayNew(if (n > 0) n else 1, false);
    let i = cellNew(0);
    while (cellGet(i) < n) {
        vecPush(grads, None);
        cellSet(i, cellGet(i) + 1)
    };
    if (loss.nodeId >= 0 && loss.nodeId < n) {
        vecSet(grads, loss.nodeId, Some(seedGrad))
    } else ();
    let k = cellNew(n - 1);
    while (cellGet(k) >= 0) {
        let idx = cellGet(k);
        match vecGet(grads, idx) {
            Some(Some(gOut)) -> match vecGet(tp.nodes, idx) {
                Some(node) -> {
                    let contribs = node.bwd(gOut);
                    let cur = cellNew(contribs);
                    while (match cellGet(cur) { Nil -> false, _ -> true }) {
                        match cellGet(cur) {
                            Cons((inId, gIn), rest) -> {
                                if (inId >= 0 && inId < n) {
                                    match vecGet(grads, inId) {
                                        Some(Some(existing)) ->
                                            if (arrayGet(owned, inId)) {
                                                axpyInPlace(1.0, gIn, existing)
                                            } else {
                                                let acc = addSameRaw(existing, gIn);
                                                vecSet(grads, inId, Some(acc));
                                                arraySet(owned, inId, true)
                                            },
                                        _ -> vecSet(grads, inId, Some(gIn)),
                                    }
                                } else ();
                                cellSet(cur, rest)
                            },
                            Nil -> (),
                        }
                    }
                },
                None -> (),
            },
            _ -> (),
        };
        cellSet(k, idx - 1)
    };
    grads
}

pub def runBackward(tp: Tape, loss: Tensor): Vec (Option Tensor) =
    runBackwardWithSeed(tp, loss, onesLike(loss))
