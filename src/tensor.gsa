extern noalloc "gs_t_bgemm" def c_bgemm(dk: Int, did: Int, batch: Int, ta: Int, tb: Int, m: Int, n: Int, k: Int, alpha: Float32, a: ScopedPtr, b: ScopedPtr, beta: Float32, c: ScopedPtr): Void

extern noalloc "gs_t_fill" def c_fill(dk: Int, did: Int, dst: ScopedPtr, n: Int64, val: Float32): Void
