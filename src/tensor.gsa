// Core N-D Float32 Tensor, multi-backend Device abstraction (Cpu / Cuda / Metal),
// ForeignPtr-backed zero-overhead memory, and local-tape reverse-mode autodiff primitives.

use std.option.{Option, Some, None}
use std.list.{listLen, listMap, listNth, listRev}
use std.vec.{Vec, vecNew, vecLen, vecPush, vecGet, vecSet}
use std.generic

// ============================================================================
// Device & Tensor Types (zero `Mk*` record/ADT shorthands)
// ============================================================================

pub data Device : Eq {
    Cpu,
    Cuda(Int),
    Metal(Int),
}

pub def devKind(d: Device): Int = match d {
    Cpu -> 0,
    Cuda(_) -> 1,
    Metal(_) -> 2,
}

pub def devId(d: Device): Int = match d {
    Cpu -> 0,
    Cuda(i) -> i,
    Metal(i) -> i,
}

pub data Tensor {
    buf: ForeignPtr,
    shape: List Int,
    numel: Int,
    device: Device,
    nodeId: Int,
}

pub data IntTensor {
    buf: ForeignPtr,
    shape: List Int,
    numel: Int,
    device: Device,
}

// ============================================================================
// Native Multi-Backend FFI (`extern noalloc` + ForeignPtr -> ScopedPtr auto-borrow)
// ============================================================================

extern noalloc "gs_t_cuda_device_count" def c_cuda_device_count(): Int
extern noalloc "gs_t_alloc" def c_alloc(dk: Int, did: Int, nbytes: Int64): Ptr
extern noalloc "gs_t_free_fn" def c_free_fn(dk: Int): Ptr
