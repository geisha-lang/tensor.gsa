pub def metalRope(xGpu: Option ForeignPtr, outGpu: Option ForeignPtr, b: Int, s: Int, h: Int, hd: Int, th: Float, bwd: Bool): Void =
    match getMetalCtx() {
        None -> (),
        Some(ctx) -> {
            let pool = c_pool_push();
            let pso = getPipeline(ctx, "k_rope");
            let cb = ensureCmdBuf(ctx);
            let enc = msg0(cb, c_sel("computeCommandEncoder"));
            msg1_v_p(enc, c_sel("setComputePipelineState:"), pso);
            let selBuf = c_sel("setBuffer:offset:atIndex:");
            msg3_v_pi64i64(enc, selBuf, unwrapGpuBuf(ctx, xGpu), intToI64(0), intToI64(0));
            msg3_v_pi64i64(enc, selBuf, unwrapGpuBuf(ctx, outGpu), intToI64(0), intToI64(1));
            withAlloca(24, (sp) -> {
                scopedPtrWriteI32Le(sp, 0, b);
                scopedPtrWriteI32Le(sp, 4, s);
                scopedPtrWriteI32Le(sp, 8, h);
                scopedPtrWriteI32Le(sp, 12, hd);
                scopedPtrWriteF32Le(sp, 16, floatToF32(th));
                scopedPtrWriteI32Le(sp, 20, if (bwd) 1 else 0);
                msg3_v_spi64i64(enc, c_sel("setBytes:length:atIndex:"), sp, intToI64(24), intToI64(2))
            });
            dispatch1d(enc, b * s * h * (hd / 2));
            msg0_v(enc, c_sel("endEncoding"));
            c_pool_pop(pool)
        },
    }

