pub def metalRmsNormFwd(xGpu: Option ForeignPtr, wGpu: Option ForeignPtr, outGpu: Option ForeignPtr, rows: Int, dim: Int, eps: Float): Void =
    match getMetalCtx() {
        None -> (),
        Some(ctx) -> {
            let pool = c_pool_push();
            let pso = getPipeline(ctx, "k_rms_fwd");
            let cb = ensureCmdBuf(ctx);
            let enc = msg0(cb, c_sel("computeCommandEncoder"));
            msg1_v_p(enc, c_sel("setComputePipelineState:"), pso);
            let selBuf = c_sel("setBuffer:offset:atIndex:");
            msg3_v_pi64i64(enc, selBuf, unwrapGpuBuf(ctx, xGpu), intToI64(0), intToI64(0));
            msg3_v_pi64i64(enc, selBuf, unwrapGpuBuf(ctx, wGpu), intToI64(0), intToI64(1));
            msg3_v_pi64i64(enc, selBuf, unwrapGpuBuf(ctx, outGpu), intToI64(0), intToI64(2));
            withAlloca(12, (sp) -> {
                scopedPtrWriteI32Le(sp, 0, rows);
                scopedPtrWriteI32Le(sp, 4, dim);
                scopedPtrWriteF32Le(sp, 8, floatToF32(eps));
                msg3_v_spi64i64(enc, c_sel("setBytes:length:atIndex:"), sp, intToI64(12), intToI64(3))
            });
            dispatchGroups1d(enc, rows, 256);
            msg0_v(enc, c_sel("endEncoding"));
            c_pool_pop(pool)
        },
    }

pub def metalRmsNormBwd(xGpu: Option ForeignPtr, wGpu: Option ForeignPtr, gyGpu: Option ForeignPtr, gxGpu: Option ForeignPtr, gwGpu: Option ForeignPtr, rows: Int, dim: Int, eps: Float): Void =
    match getMetalCtx() {
        None -> (),
        Some(ctx) -> {
            let pool = c_pool_push();
            let (_, invOpt) = metalAllocShared(intToI64(rows) * intToI64(4));
            let invBuf = unwrapGpuBuf(ctx, invOpt);
            let xBuf = unwrapGpuBuf(ctx, xGpu);
            let wBuf = unwrapGpuBuf(ctx, wGpu);
            let gyBuf = unwrapGpuBuf(ctx, gyGpu);
            let gxBuf = unwrapGpuBuf(ctx, gxGpu);
            let gwBuf = unwrapGpuBuf(ctx, gwGpu);
            let cb = ensureCmdBuf(ctx);
            let enc = msg0(cb, c_sel("computeCommandEncoder"));
            let selBuf = c_sel("setBuffer:offset:atIndex:");
            let selBytes = c_sel("setBytes:length:atIndex:");
            withAlloca(12, (sp) -> {
                scopedPtrWriteI32Le(sp, 0, rows);
                scopedPtrWriteI32Le(sp, 4, dim);
                scopedPtrWriteF32Le(sp, 8, floatToF32(eps));
                msg1_v_p(enc, c_sel("setComputePipelineState:"), getPipeline(ctx, "k_rms_bwd_x"));
                msg3_v_pi64i64(enc, selBuf, xBuf, intToI64(0), intToI64(0));
                msg3_v_pi64i64(enc, selBuf, wBuf, intToI64(0), intToI64(1));
                msg3_v_pi64i64(enc, selBuf, gyBuf, intToI64(0), intToI64(2));
                msg3_v_pi64i64(enc, selBuf, gxBuf, intToI64(0), intToI64(3));
                msg3_v_pi64i64(enc, selBuf, invBuf, intToI64(0), intToI64(4));
                msg3_v_spi64i64(enc, selBytes, sp, intToI64(12), intToI64(5));
                dispatchGroups1d(enc, rows, 256);

                msg1_v_p(enc, c_sel("setComputePipelineState:"), getPipeline(ctx, "k_rms_bwd_w"));
                msg3_v_pi64i64(enc, selBuf, xBuf, intToI64(0), intToI64(0));
                msg3_v_pi64i64(enc, selBuf, gyBuf, intToI64(0), intToI64(1));
                msg3_v_pi64i64(enc, selBuf, invBuf, intToI64(0), intToI64(2));
                msg3_v_pi64i64(enc, selBuf, gwBuf, intToI64(0), intToI64(3));
                msg3_v_spi64i64(enc, selBytes, sp, intToI64(12), intToI64(4));
                dispatch1d(enc, dim)
            });
            msg0_v(enc, c_sel("endEncoding"));
            c_pool_pop(pool)
        },
    }

pub def metalSoftmaxFwd(xGpu: Option ForeignPtr, outGpu: Option ForeignPtr, rows: Int, cols: Int): Void =
    match getMetalCtx() {
        None -> (),
        Some(ctx) -> {
            let pool = c_pool_push();
            let pso = getPipeline(ctx, "k_sm_fwd");
            let cb = ensureCmdBuf(ctx);
            let enc = msg0(cb, c_sel("computeCommandEncoder"));
            msg1_v_p(enc, c_sel("setComputePipelineState:"), pso);
            let selBuf = c_sel("setBuffer:offset:atIndex:");
            msg3_v_pi64i64(enc, selBuf, unwrapGpuBuf(ctx, xGpu), intToI64(0), intToI64(0));
            msg3_v_pi64i64(enc, selBuf, unwrapGpuBuf(ctx, outGpu), intToI64(0), intToI64(1));
            withAlloca(8, (sp) -> {
                scopedPtrWriteI32Le(sp, 0, rows);
                scopedPtrWriteI32Le(sp, 4, cols);
                msg3_v_spi64i64(enc, c_sel("setBytes:length:atIndex:"), sp, intToI64(8), intToI64(2))
            });
            dispatchGroups1d(enc, rows, 256);
            msg0_v(enc, c_sel("endEncoding"));
            c_pool_pop(pool)
        },
    }

