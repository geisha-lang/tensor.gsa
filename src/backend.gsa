// Multi-backend `Device` ADT and native C/CUDA/Accelerate FFI bindings (`tensor.backend`).

use std.generic

pub data Device : Eq {
    Cpu,
    Cuda(Int),
    Metal(Int),
}

pub def devKind(d: Device): Int = match d {
    Cpu -> 0,
    Cuda(_) -> 1,
    Metal(_) -> 2,
}

pub def devId(d: Device): Int = match d {
    Cpu -> 0,
    Cuda(i) -> i,
    Metal(i) -> i,
}

// ============================================================================
// Native Multi-Backend FFI (`extern noalloc` + ForeignPtr -> ScopedPtr auto-borrow)
// ============================================================================

pub extern noalloc "gs_t_cuda_device_count" def c_cuda_device_count(): Int
pub extern noalloc "gs_t_alloc" def c_alloc(dk: Int, did: Int, nbytes: Int64): Ptr
pub extern noalloc "gs_t_free_fn" def c_free_fn(dk: Int): Ptr
pub extern noalloc "gs_t_memcpy_dev" def c_memcpy_dev(dst: ScopedPtr, ddk: Int, ddid: Int, src: ScopedPtr, sdk: Int, sdid: Int, nbytes: Int64): Void

pub extern noalloc "gs_t_sgemm" def c_sgemm(dk: Int, did: Int, ta: Int, tb: Int, m: Int, n: Int, k: Int, alpha: Float32, a: ScopedPtr, b: ScopedPtr, beta: Float32, c: ScopedPtr): Void
pub extern noalloc "gs_t_bgemm" def c_bgemm(dk: Int, did: Int, batch: Int, ta: Int, tb: Int, m: Int, n: Int, k: Int, alpha: Float32, a: ScopedPtr, b: ScopedPtr, beta: Float32, c: ScopedPtr): Void

