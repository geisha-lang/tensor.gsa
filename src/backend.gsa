// Multi-backend `Device` ADT and minimal BLAS FFI (`tensor.backend`).
// All CPU elementwise, broadcast, norm, reduction, activation, RoPE, PRNG and AdamW kernels
// run in pure Geisha (`tensor.cpu`); `native/blas.c` provides only BLAS SGEMM/BGEMM.

use std.generic

pub data Device : Eq {
    Cpu,
    Cuda(Int),
    Metal(Int),
}

pub def devKind(d: Device): Int = match d {
    Cpu -> 0,
    Cuda(_) -> 1,
    Metal(_) -> 2,
}

pub def devId(d: Device): Int = match d {
    Cpu -> 0,
    Cuda(i) -> i,
    Metal(i) -> i,
}

pub extern noalloc "gs_t_cuda_device_count" def c_cuda_device_count(): Int
pub extern noalloc "gs_t_sgemm_cpu" def c_sgemm_cpu(ta: Int, tb: Int, m: Int, n: Int, k: Int, alpha: Float32, a: ScopedPtr, b: ScopedPtr, beta: Float32, c: ScopedPtr): Void
pub extern noalloc "gs_t_bgemm_cpu" def c_bgemm_cpu(batch: Int, ta: Int, tb: Int, m: Int, n: Int, k: Int, alpha: Float32, a: ScopedPtr, b: ScopedPtr, beta: Float32, c: ScopedPtr): Void

pub def cudaDeviceCount(): Int = c_cuda_device_count()
pub def autoDevice(): Device = if (c_cuda_device_count() > 0) Cuda(0) else Cpu
