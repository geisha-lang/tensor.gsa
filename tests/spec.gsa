// End-to-end verification suite for `tensor.gsa` (`tests/spec.gsa`):
// 1. Analytic vs finite-difference gradient check (Linear + RMSNorm + SiLU + CrossEntropy)
// 2. Mini Llama-style CausalLM training with AdamW
// 3. Mini Llama-style CausalLM training with Muon (Newton-Schulz)
// 4. Pure-Geisha Safetensors + HuggingFace `config.json` roundtrip & key parity

use std.result.{Result, Ok, Err}
use std.list.{listLen}
use std.str.{intToStr, floatToStr}
use sys.fs.removeFile
use sys.io.eprintLn
use sys.proc.exit

use tensor.tensor.{
    Tensor, Cpu, fromList, fromI32List, getAt, item,
    silu, rmsNorm, crossEntropy, matmulNT, meanAll, sub, l2NormFloat
}
use tensor.ad.{Params, valueAndGrad, paramCount}
use tensor.nn.{
    LMConfig, CausalLM, rngNew, initCausalLM, causalLMFwd
}
use tensor.optim.{
    defaultAdamW, adamwInit, adamwStep,
    defaultMuon, muonInit, muonStep, clipGradNorm
}
use tensor.safetensors.{
    StateDict, stateDictList, saveSafetensors, loadSafetensors,
    HfLlamaConfig, saveHfLlamaConfig
}

def absF(x: Float): Float = if (x < 0.0) -x else x

def assertTrue(label: String, ok: Bool): Result Void String =
    if (ok) Ok(()) else Err("ASSERT FAILED: " + label)

def hasKey(xs: List (String, Tensor), target: String): Bool = match xs {
    Nil -> false,
    Cons((k, _), r) -> if (k == target) true else hasKey(r, target),
}

// 1. Finite-difference gradient verification
data TinyNet : Params {
    w: Tensor,
    gamma: Tensor,
}

def testGradCheck(): Result Void String = {
    let x = fromList([2, 4], [0.5, -0.3, 0.8, 0.2, -0.4, 0.6, -0.1, 0.9]);
    let w = fromList([3, 4], [0.2, -0.1, 0.4, 0.3, -0.5, 0.2, 0.1, -0.3, 0.3, 0.4, -0.2, 0.1]);
    let g = fromList([4], [1.1, 0.9, 1.05, 0.95]);
    let targets = fromI32List([2], [1, 2]);
    let net = TinyNet { w: w, gamma: g };
    let lossFn = (m: TinyNet) -> {
        let h = silu(rmsNorm(x, m.gamma, 1.0e-5));
        let logits = matmulNT(h, m.w);
        crossEntropy(logits, targets)
    };
    let (_, grads) = valueAndGrad(net, lossFn);
    let analyticW0 = getAt(grads.w, 0);
    let analyticG1 = getAt(grads.gamma, 1);

    // Finite-difference on w[0]
    let eps = 1.0e-3;
    let wPlus = fromList([3, 4], [0.2 + eps, -0.1, 0.4, 0.3, -0.5, 0.2, 0.1, -0.3, 0.3, 0.4, -0.2, 0.1]);
    let wMinus = fromList([3, 4], [0.2 - eps, -0.1, 0.4, 0.3, -0.5, 0.2, 0.1, -0.3, 0.3, 0.4, -0.2, 0.1]);
    let fdW0 = (item(lossFn(TinyNet { w: wPlus, gamma: g })) - item(lossFn(TinyNet { w: wMinus, gamma: g }))) / (2.0 * eps);

    // Finite-difference on gamma[1]
    let gPlus = fromList([4], [1.1, 0.9 + eps, 1.05, 0.95]);
    let gMinus = fromList([4], [1.1, 0.9 - eps, 1.05, 0.95]);
    let fdG1 = (item(lossFn(TinyNet { w: w, gamma: gPlus })) - item(lossFn(TinyNet { w: w, gamma: gMinus }))) / (2.0 * eps);

    let _ = assertTrue("grad_w0_match", absF(analyticW0 - fdW0) < 1.0e-2)?;
    let _ = assertTrue("grad_gamma1_match", absF(analyticG1 - fdG1) < 1.0e-2)?;
    Ok(())
}

// 2 & 3. Mini CausalLM training with AdamW and Muon
def makeMiniCfg(): LMConfig = LMConfig {
    vocabSize: 16,
    hiddenSize: 32,
    intermediateSize: 64,
    numLayers: 2,
    numHeads: 4,
    rmsNormEps: 1.0e-5,
    ropeTheta: 10000.0,
    device: Cpu,
}

def testTrainAdamW(): Result CausalLM String = {
    let cfg = makeMiniCfg();
    let (lm0, _) = initCausalLM(cfg, rngNew(42));
    let _ = assertTrue("param_count_positive", paramCount(lm0) > 10000)?;
    let inp = fromI32List([1, 6], [1, 2, 3, 4, 5, 6]);
    let tgt = fromI32List([1, 6], [2, 3, 4, 5, 6, 7]);
    let optCfg = defaultAdamW(0.02);
    let lmCell = cellNew(lm0);
    let stCell = cellNew(adamwInit(lm0));
    let firstLoss = cellNew(0.0);
    let lastLoss = cellNew(0.0);
    let step = cellNew(0);
    while (cellGet(step) < 25) {
        let (loss, grads) = valueAndGrad(cellGet(lmCell), (m) -> crossEntropy(causalLMFwd(m, inp), tgt));
        if (cellGet(step) == 0) cellSet(firstLoss, loss) else ();
        cellSet(lastLoss, loss);
        let clipped = clipGradNorm(grads, 1.0);
        let (lmNext, stNext) = adamwStep(optCfg, cellGet(stCell), cellGet(lmCell), clipped);
        cellSet(lmCell, lmNext);
        cellSet(stCell, stNext);
        cellSet(step, cellGet(step) + 1)
    };
    let _ = assertTrue("adamw_loss_dropped", cellGet(lastLoss) < cellGet(firstLoss) * 0.25)?;
    Ok(cellGet(lmCell))
}

def testTrainMuon(): Result Void String = {
    let cfg = makeMiniCfg();
    let (lm0, _) = initCausalLM(cfg, rngNew(99));
    let inp = fromI32List([1, 6], [1, 3, 5, 7, 9, 11]);
    let tgt = fromI32List([1, 6], [3, 5, 7, 9, 11, 13]);
    let optCfg = defaultMuon(0.03);
    let lmCell = cellNew(lm0);
    let stCell = cellNew(muonInit(lm0));
    let firstLoss = cellNew(0.0);
    let lastLoss = cellNew(0.0);
    let step = cellNew(0);
    while (cellGet(step) < 25) {
        let (loss, grads) = valueAndGrad(cellGet(lmCell), (m) -> crossEntropy(causalLMFwd(m, inp), tgt));
        if (cellGet(step) == 0) cellSet(firstLoss, loss) else ();
        cellSet(lastLoss, loss);
        let (lmNext, stNext) = muonStep(optCfg, cellGet(stCell), cellGet(lmCell), grads);
        cellSet(lmCell, lmNext);
        cellSet(stCell, stNext);
        cellSet(step, cellGet(step) + 1)
    };
    let _ = assertTrue("muon_loss_dropped", cellGet(lastLoss) < cellGet(firstLoss) * 0.25)?;
    Ok(())
}

// 4. Safetensors + HF config.json roundtrip & key parity
def testSafetensorsRoundtrip(trained: CausalLM): Result Void String = {
    let sd = stateDictList(trained);
    let _ = assertTrue("hf_key_embed", hasKey(sd, "model.embed_tokens.weight"))?;
    let _ = assertTrue("hf_key_qproj", hasKey(sd, "model.layers.0.self_attn.q_proj.weight"))?;
    let _ = assertTrue("hf_key_gate", hasKey(sd, "model.layers.1.mlp.gate_proj.weight"))?;
    let _ = assertTrue("hf_key_norm", hasKey(sd, "model.norm.weight"))?;
    let _ = assertTrue("hf_key_lm_head", hasKey(sd, "lm_head.weight"))?;

    let stPath = "/tmp/tensor_gsa_spec_model.safetensors";
    let cfgPath = "/tmp/tensor_gsa_spec_config.json";
    let nSaved = saveSafetensors(stPath, trained)?;
    let _ = assertTrue("saved_tensor_count", nSaved == listLen(sd))?;
    let _ = saveHfLlamaConfig(cfgPath, HfLlamaConfig {
        vocabSize: 16,
        hiddenSize: 32,
        intermediateSize: 64,
        numHiddenLayers: 2,
        numAttentionHeads: 4,
        rmsNormEps: 1.0e-5,
        ropeTheta: 10000.0,
    })?;

    // Reload into a freshly initialized model with different seed
    let (fresh, _) = initCausalLM(makeMiniCfg(), rngNew(777));
    let reloaded = loadSafetensors(stPath, fresh)?;
    let inp = fromI32List([1, 6], [1, 2, 3, 4, 5, 6]);
    let out1 = causalLMFwd(trained, inp);
    let out2 = causalLMFwd(reloaded, inp);
    let diff = l2NormFloat(sub(out1, out2));
    let _ = removeFile(stPath);
    let _ = removeFile(cfgPath);
    let _ = assertTrue("safetensors_logits_exact", diff < 1.0e-5)?;
    Ok(())
}

def runAll(): Result Void String = {
    let _ = testGradCheck()?;
    let trained = testTrainAdamW()?;
    let _ = testTrainMuon()?;
    let _ = testSafetensorsRoundtrip(trained)?;
    Ok(())
}

def main(): Void = match runAll() {
    Ok(_) -> printLn("PASS [tensor.gsa]: gradcheck + AdamW + Muon + HF safetensors roundtrip"),
    Err(msg) -> {
        eprintLn(msg);
        exit(1)
    },
}
